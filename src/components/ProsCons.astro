---
interface Props {
  pros: string[];
  cons: string[];
}

const { pros, cons } = Astro.props;
---

<div class="grid gap-4 md:grid-cols-2">
  <section class="card p-5">
    <h3 class="flex items-center gap-2 font-sans text-base font-semibold text-good">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-good-wash" aria-hidden="true">
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M8 3v10M3 8h10" /></svg>
      </span>
      Pros
    </h3>
    <ul class="mt-3 space-y-2.5 text-[0.975rem] leading-snug text-ink-soft">
      {pros.map((item) => <li class="flex gap-2.5"><span class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-good" aria-hidden="true" />{item}</li>)}
    </ul>
  </section>

  <section class="card p-5">
    <h3 class="flex items-center gap-2 font-sans text-base font-semibold text-bad">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-bad-wash" aria-hidden="true">
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M3 8h10" /></svg>
      </span>
      Cons
    </h3>
    <ul class="mt-3 space-y-2.5 text-[0.975rem] leading-snug text-ink-soft">
      {cons.map((item) => <li class="flex gap-2.5"><span class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-bad" aria-hidden="true" />{item}</li>)}
    </ul>
  </section>
</div>

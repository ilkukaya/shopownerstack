---
import { moneyOr } from '../lib/format';

interface Props {
  name: string;
  pricing: {
    name: string;
    users: string;
    monthly: number | null;
    annual: number | null;
    forWhom: string;
  }[];
}

const { name, pricing } = Astro.props;
---

<div class="table-scroll card">
  <table class="data-table min-w-[38rem]">
    <caption class="sr-only">{name} pricing plans</caption>
    <thead>
      <tr>
        <th scope="col">Plan</th>
        <th scope="col">Users</th>
        <th scope="col">Billed monthly</th>
        <th scope="col">Billed annually</th>
        <th scope="col">Best for</th>
      </tr>
    </thead>
    <tbody>
      {
        pricing.map((plan) => (
          <tr>
            <th scope="row" class="font-semibold text-ink">{plan.name}</th>
            <td class="text-sm text-ink-soft">{plan.users}</td>
            <td class="font-semibold tabular-nums text-ink">{moneyOr(plan.monthly, 'Quote')}{plan.monthly !== null && <span class="text-sm font-normal text-ink-muted">/mo</span>}</td>
            <td class="font-semibold tabular-nums text-ink">{moneyOr(plan.annual, 'Quote')}{plan.annual !== null && <span class="text-sm font-normal text-ink-muted">/mo</span>}</td>
            <td class="text-sm leading-snug text-ink-soft">{plan.forWhom}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

---
interface Props {
  name: string;
  measurements: { test: string; result: string }[];
}

const { name, measurements } = Astro.props;
---

<div class="table-scroll board">
  <table class="w-full min-w-[32rem] border-collapse text-left">
    <caption class="sr-only">What we measured while testing {name}</caption>
    <thead>
      <tr class="bg-ink text-white">
        <th scope="col" class="px-4 py-3 font-condensed text-sm font-bold uppercase tracking-[0.1em]">
          What we timed
        </th>
        <th scope="col" class="px-4 py-3 font-condensed text-sm font-bold uppercase tracking-[0.1em]">
          Result
        </th>
      </tr>
    </thead>
    <tbody>
      {
        measurements.map((m) => (
          <tr class="border-t border-line align-top">
            <th scope="row" class="px-4 py-3 font-normal">{m.test}</th>
            <td class="px-4 py-3 font-condensed text-lg font-bold uppercase text-ink">{m.result}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

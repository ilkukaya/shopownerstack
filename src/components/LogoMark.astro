---
import { readableMark } from '../lib/color';

interface Props {
  text: string;
  color: string;
  size?: 'xs' | 'sm' | 'md' | 'lg';
  class?: string;
}

const { text, color, size = 'md', class: className = '' } = Astro.props;

// Brand colours are picked for recognition, not contrast. This keeps the hue
// and guarantees the letters on the mark clear AA.
const { bg, fg } = readableMark(color);

const sizes = {
  xs: 'h-7 w-7 rounded-md text-[0.55rem]',
  sm: 'h-10 w-10 rounded-[10px] text-[0.68rem]',
  md: 'h-12 w-12 rounded-xl text-[0.8rem]',
  lg: 'h-16 w-16 rounded-2xl text-base',
};
---

<span
  class:list={[
    'flex flex-none items-center justify-center font-sans font-bold uppercase leading-none tracking-tight',
    sizes[size],
    className,
  ]}
  style={`background-color:${bg};color:${fg}`}
  aria-hidden="true">{text}</span
>

---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-7 w-7' } = Astro.props;

/**
 * Inline stroke icons, one per trade `icon` key. Inline keeps them out of the
 * network waterfall and lets them inherit currentColor.
 */
const PATHS: Record<string, string> = {
  pipe: 'M3 8h6a3 3 0 0 1 3 3v2a3 3 0 0 0 3 3h6M6 5v6M18 13v6',
  flame: 'M12 3c2.5 3 4 5 4 7.5a4 4 0 0 1-8 0C8 8.5 9.5 6 12 3ZM6 14a6 6 0 0 0 12 0',
  bolt: 'M13 3 5 14h6l-2 7 8-11h-6l2-7Z',
  spray: 'M9 4h4v3H9zM7 7h8v13H7zM17 5h3M17 8h3M17 11h3',
  leaf: 'M5 19C5 11 10 6 19 5c1 9-4 14-12 14ZM5 19c3-3 6-5 9-6',
  scissors: 'M7 5l10 12M17 5 7 17M7 17a2.5 2.5 0 1 1-3 2M17 17a2.5 2.5 0 1 0 3 2',
  dumbbell: 'M4 9v6M8 7v10M16 7v10M20 9v6M8 12h8',
  wrench: 'M14.5 4a5 5 0 0 0-4.9 6L4 15.6V20h4.4l5.6-5.6a5 5 0 0 0 6-6l-3 3-3-1-1-3 3-3Z',
};

const d = PATHS[name] ?? PATHS.wrench;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={d}></path>
</svg>

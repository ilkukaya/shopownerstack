---
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
  id?: string;
}

const { items, heading = 'Common questions', id = 'faq' } = Astro.props;
---

{
  items.length > 0 && (
    <section id={id} class="mt-14">
      <h2 class="font-condensed text-3xl font-bold uppercase tracking-wide sm:text-4xl">
        {heading}
      </h2>
      <div class="mt-5 border-t border-line">
        {items.map((item) => (
          // Native <details>, so the FAQ needs no JavaScript at all.
          <details class="group border-b border-line">
            <summary class="flex items-start justify-between gap-4 py-4 font-condensed text-xl font-semibold uppercase tracking-wide text-ink">
              <span>{item.q}</span>
              <span
                class="mt-1 flex h-5 w-5 flex-none items-center justify-center border-2 border-ink text-ink"
                aria-hidden="true"
              >
                <svg viewBox="0 0 12 12" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M1 6h10" />
                  <path d="M6 1v10" class="group-open:hidden" />
                </svg>
              </span>
            </summary>
            <p class="pb-5 pr-9 leading-relaxed text-ink-soft">{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}

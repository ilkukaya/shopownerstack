---
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
  id?: string;
}

const { items, heading = 'Frequently asked questions', id = 'faq' } = Astro.props;
---

{
  items.length > 0 && (
    <section id={id} class="mt-14 scroll-mt-24">
      <h2 class="section-title">{heading}</h2>
      <div class="mt-5 divide-y divide-line overflow-hidden rounded-[14px] border border-line bg-white">
        {items.map((item, i) => (
          // Native <details>, so the FAQ needs no JavaScript at all. The
          // answer text is in the DOM either way, so crawlers see it.
          <details class="group" open={i === 0}>
            <summary class="flex items-start justify-between gap-4 px-5 py-4 text-[1.025rem] font-semibold leading-snug text-ink transition-colors hover:bg-paper">
              <h3 class="font-sans text-[1.025rem] font-semibold tracking-normal">{item.q}</h3>
              <svg class="mt-1 h-4 w-4 flex-none text-ink-muted transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="m3.5 6 4.5 4.5L12.5 6" />
              </svg>
            </summary>
            <p class="px-5 pb-5 leading-relaxed text-ink-soft">{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}

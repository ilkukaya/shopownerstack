---
import LogoMark from './LogoMark.astro';
import ScoreBadge from './ScoreBadge.astro';
import { toolUrl } from '../lib/urls';
import { priceLabel } from '../lib/format';

interface Props {
  tool: {
    name: string;
    slug: string;
    logoText: string;
    logoColor: string;
    score: number;
    bestFor: string;
    priceFrom: number | null;
  };
  /** Optional line explaining why this tool is in this list. */
  note?: string;
  label?: string;
}

const { tool, note, label } = Astro.props;
---

<a href={toolUrl(tool.slug)} class="card card-link group flex h-full flex-col p-5 no-underline">
  {label && <span class="pill pill-brand mb-3 self-start">{label}</span>}
  <div class="flex items-start gap-3">
    <LogoMark text={tool.logoText} color={tool.logoColor} size="sm" />
    <div class="min-w-0 flex-1">
      <h3 class="font-sans text-lg font-semibold leading-tight tracking-tight text-ink group-hover:text-brand">
        {tool.name}
      </h3>
      <p class="mt-0.5 text-sm text-ink-muted">{priceLabel(tool.priceFrom)}</p>
    </div>
    <ScoreBadge score={tool.score} />
  </div>
  <p class="mt-4 flex-1 text-[0.95rem] leading-relaxed text-ink-soft">{note ?? tool.bestFor}</p>
  <span class="mt-4 text-sm font-semibold text-brand">Read review <span aria-hidden="true">&rarr;</span></span>
</a>

---
import LogoMark from './LogoMark.astro';
import { toolUrl } from '../lib/urls';
import { money, score1 } from '../lib/format';

interface Props {
  tool: {
    name: string;
    slug: string;
    logoText: string;
    logoColor: string;
    score: number;
    bestFor: string;
    priceFrom: number;
  };
  /** Optional line explaining why this tool is in this list. */
  note?: string;
}

const { tool, note } = Astro.props;
---

<a
  href={toolUrl(tool.slug)}
  class="board group flex h-full flex-col p-4 no-underline transition-colors hover:border-ink"
>
  <div class="flex items-start gap-3">
    <LogoMark text={tool.logoText} color={tool.logoColor} size="sm" />
    <div class="min-w-0 flex-1">
      <h3 class="font-condensed text-xl font-bold uppercase leading-none group-hover:underline">
        {tool.name}
      </h3>
      <p class="mt-1 text-sm text-ink-muted">From {money(tool.priceFrom)}/mo</p>
    </div>
    <span class="flex-none font-condensed text-2xl font-bold leading-none">{score1(tool.score)}</span>
  </div>
  <p class="mt-3 text-[0.95rem] leading-snug text-ink-soft">{note ?? tool.bestFor}</p>
</a>

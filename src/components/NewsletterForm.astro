---
interface Props {
  variant?: 'ink' | 'paper';
  class?: string;
}

const { variant = 'ink', class: className = '' } = Astro.props;
const onInk = variant === 'ink';
---

<!--
  KIT (CONVERTKIT) SLOT
  =====================
  Posts to Netlify Forms for now so nothing is lost before the mailing list
  exists. To move to Kit:

    1. Replace action="/thanks/" with the Kit form action URL,
       e.g. https://app.kit.com/forms/<form-id>/subscriptions
    2. Remove data-netlify="true", the netlify-honeypot attribute and the
       hidden form-name input.
    3. Rename the email field to email_address, which is what Kit expects.

  Nothing else in this component needs to change.
-->
<section
  class:list={[onInk ? 'on-ink bg-ink text-white' : 'board bg-white text-ink', className]}
  aria-labelledby="newsletter-heading"
>
  <div class:list={[onInk ? 'wrap py-12' : 'p-6']}>
    <div class="grid items-center gap-6 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <p class="eyebrow">The retest list</p>
        <h2
          id="newsletter-heading"
          class="mt-3 font-condensed text-3xl font-bold uppercase leading-none sm:text-4xl"
        >
          One email when a score changes
        </h2>
        <p class:list={['mt-3 max-w-lg', onInk ? 'text-white/75' : 'text-ink-soft']}>
          We retest every tool on this site twice a year and check prices more often than that.
          When a score moves or a vendor changes what a plan includes, you get one short email.
          Nothing else.
        </p>
      </div>

      <form
        name="newsletter"
        method="POST"
        data-netlify="true"
        netlify-honeypot="company-website"
        action="/thanks/"
        class="flex flex-col gap-3 sm:flex-row sm:items-start"
      >
        <input type="hidden" name="form-name" value="newsletter" />
        <p class="hidden" aria-hidden="true">
          <label>Do not fill this in <input name="company-website" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="flex-1">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            type="email"
            id="newsletter-email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@yourshop.com"
            class:list={[
              'w-full border px-3 py-3 text-ink',
              onInk ? 'border-ink-line bg-white' : 'border-line bg-paper',
            ]}
          />
          <p class:list={['mt-2 text-sm', onInk ? 'text-white/60' : 'text-ink-muted']}>
            No more than twice a month. Unsubscribe in one click.
          </p>
        </div>

        <button type="submit" class="btn btn-primary sm:mt-0">Send it</button>
      </form>
    </div>
  </div>
</section>

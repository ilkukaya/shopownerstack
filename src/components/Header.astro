---
import SiteLogo from './SiteLogo.astro';
import { NAV, SITE } from '../lib/site';
import { SEARCH_URL } from '../lib/urls';

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/80">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex-none no-underline" aria-label={`${SITE.name} home`}>
      <SiteLogo />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded-lg px-3 py-2 text-[0.95rem] font-medium no-underline transition-colors',
                  isActive(item.href)
                    ? 'bg-brand-wash text-brand-deep'
                    : 'text-ink-soft hover:bg-paper-deep hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1.5">
      <a
        href={SEARCH_URL}
        class="flex h-10 w-10 items-center justify-center rounded-lg text-ink-soft no-underline transition-colors hover:bg-paper-deep hover:text-ink"
        aria-label="Search the site"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
      <a href="/best/" class="btn btn-primary hidden !min-h-10 !py-2 text-sm sm:inline-flex lg:hidden xl:inline-flex">
        Find my software
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-ink transition-colors hover:bg-paper-deep lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">Open menu</span>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path data-open d="M4 7h16M4 12h16M4 17h16"></path>
          <path data-close d="M6 6l12 12M18 6 6 18" style="display:none"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Main" hidden class="border-t border-line bg-white lg:hidden">
    <ul class="wrap flex flex-col py-2">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between rounded-lg px-2 py-3.5 text-[1.05rem] font-medium no-underline',
                isActive(item.href) ? 'text-brand' : 'text-ink',
              ]}
            >
              {item.label}
              <svg class="h-4 w-4 text-ink-muted" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
            </a>
          </li>
        ))
      }
      <li class="px-2 pb-3 pt-2">
        <a href="/best/" class="btn btn-primary btn-block">Find my software</a>
      </li>
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById('menu-toggle');
    var nav = document.getElementById('mobile-nav');
    if (!toggle || !nav) return;
    var openIcon = toggle.querySelector('[data-open]');
    var closeIcon = toggle.querySelector('[data-close]');

    toggle.addEventListener('click', function () {
      var open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      nav.hidden = open;
      openIcon.style.display = open ? '' : 'none';
      closeIcon.style.display = open ? 'none' : '';
      toggle.querySelector('.sr-only').textContent = open ? 'Open menu' : 'Close menu';
    });
  })();
</script>

---
import LogoMark from './LogoMark.astro';

interface Props {
  a: { name: string; logoText: string; logoColor: string };
  b: { name: string; logoText: string; logoColor: string };
  rows: { feature: string; a: string; b: string; winner: 'a' | 'b' | 'tie' }[];
}

const { a, b, rows } = Astro.props;

const winCount = (side: 'a' | 'b') => rows.filter((r) => r.winner === side).length;
const ties = rows.filter((r) => r.winner === 'tie').length;
const win = 'bg-brand-wash font-medium text-ink shadow-[inset_3px_0_0_0_var(--color-brand)]';
---

<div class="table-scroll card">
  <table class="data-table min-w-[40rem]">
    <caption class="sr-only">
      {a.name} compared with {b.name}, feature by feature. Stronger cells are highlighted and labelled.
    </caption>
    <thead>
      <tr>
        <th scope="col" class="w-[28%]">Feature</th>
        <th scope="col">
          <span class="flex items-center gap-2 text-sm text-ink">
            <LogoMark text={a.logoText} color={a.logoColor} size="xs" />
            {a.name}
          </span>
        </th>
        <th scope="col">
          <span class="flex items-center gap-2 text-sm text-ink">
            <LogoMark text={b.logoText} color={b.logoColor} size="xs" />
            {b.name}
          </span>
        </th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row" class="text-[0.95rem] font-semibold text-ink">{row.feature}</th>
            <td class:list={['text-[0.95rem] leading-snug text-ink-soft', row.winner === 'a' && win]}>
              {row.winner === 'a' && <span class="sr-only">Stronger: </span>}
              {row.a}
            </td>
            <td class:list={['text-[0.95rem] leading-snug text-ink-soft', row.winner === 'b' && win]}>
              {row.winner === 'b' && <span class="sr-only">Stronger: </span>}
              {row.b}
            </td>
          </tr>
        ))
      }
    </tbody>
    <tfoot>
      <tr class="bg-paper">
        <th scope="row" class="text-sm font-semibold">Rows where stronger</th>
        <td class="text-lg font-bold tabular-nums">{winCount('a')}</td>
        <td class="text-lg font-bold tabular-nums">{winCount('b')}</td>
      </tr>
    </tfoot>
  </table>
</div>

<p class="mt-2 text-sm text-ink-muted">
  {ties} row{ties === 1 ? '' : 's'} called even. Highlighted cells mark the stronger product on that row,
  in our judgement. The tally is not the verdict: one row can matter more than the rest combined.
</p>

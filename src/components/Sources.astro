---
interface Props {
  sources: { title: string; url: string }[];
  class?: string;
}

const { sources, class: className = '' } = Astro.props;
---

{
  sources.length > 0 && (
    <section class:list={['mt-12', className]} aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="font-sans text-base font-semibold text-ink">Sources</h2>
      <p class="mt-1 text-sm text-ink-muted">
        Public pages we checked facts and prices against. Vendors change plans often; confirm on the
        vendor's site before you buy.
      </p>
      <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-sm text-ink-soft marker:text-ink-muted">
        {sources.map((s) => (
          <li>
            <a href={s.url} rel="nofollow noopener" target="_blank" class="break-words text-ink-soft underline decoration-line-strong underline-offset-2 hover:text-brand">
              {s.title}
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}

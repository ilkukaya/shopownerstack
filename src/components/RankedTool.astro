---
import LogoMark from './LogoMark.astro';
import AffiliateLink from './AffiliateLink.astro';
import { toolUrl } from '../lib/urls';
import { money, score1 } from '../lib/format';
import { TEAM_SIZE_LABELS, type TeamSize } from '../lib/site';

interface Props {
  rank: number;
  tool: {
    name: string;
    slug: string;
    logoText: string;
    logoColor: string;
    score: number;
    bestFor: string;
    priceFrom: number;
    teamSizes: TeamSize[];
    pros: string[];
    cons: string[];
    verdict: string;
  };
}

const { rank, tool } = Astro.props;
---

<article
  class="board p-5 sm:p-6"
  data-tool-card
  data-sizes={tool.teamSizes.join(' ')}
  id={`pick-${tool.slug}`}
>
  <div class="flex flex-wrap items-start gap-4">
    <span
      class="flex h-10 w-10 flex-none items-center justify-center bg-ink font-condensed text-xl font-bold leading-none text-yellow"
      aria-hidden="true">{rank}</span
    >
    <LogoMark text={tool.logoText} color={tool.logoColor} size="md" />

    <div class="min-w-0 flex-1">
      <h3 class="font-condensed text-2xl font-bold uppercase leading-none sm:text-3xl">
        <span class="sr-only">Number {rank}: </span>
        <a href={toolUrl(tool.slug)} class="no-underline hover:underline">{tool.name}</a>
      </h3>
      <p class="mt-1.5 text-ink-soft">{tool.bestFor}</p>
    </div>

    <div class="flex flex-none items-baseline gap-1.5 font-condensed leading-none">
      <span class="text-3xl font-bold">{score1(tool.score)}</span>
      <span class="text-sm font-semibold text-ink-muted">/ 10</span>
    </div>
  </div>

  <dl class="mt-4 flex flex-wrap gap-x-8 gap-y-2 border-y border-line py-3 text-sm">
    <div class="flex gap-2">
      <dt class="font-condensed font-bold uppercase tracking-[0.1em] text-ink-muted">From</dt>
      <dd class="font-semibold">{money(tool.priceFrom)}/mo</dd>
    </div>
    <div class="flex gap-2">
      <dt class="font-condensed font-bold uppercase tracking-[0.1em] text-ink-muted">Fits</dt>
      <dd class="font-semibold">{tool.teamSizes.map((s) => TEAM_SIZE_LABELS[s]).join(', ')}</dd>
    </div>
  </dl>

  <p class="mt-4 leading-relaxed">{tool.verdict}</p>

  <div class="mt-4 grid gap-x-8 gap-y-2 sm:grid-cols-2">
    <p class="text-[0.95rem] leading-snug">
      <span class="font-condensed font-bold uppercase tracking-[0.1em] text-good">Best bit</span>
      <span class="mt-0.5 block">{tool.pros[0]}</span>
    </p>
    <p class="text-[0.95rem] leading-snug">
      <span class="font-condensed font-bold uppercase tracking-[0.1em] text-bad">Worst bit</span>
      <span class="mt-0.5 block">{tool.cons[0]}</span>
    </p>
  </div>

  <div class="mt-5 flex flex-wrap gap-3">
    <AffiliateLink slug={tool.slug} name={tool.name} variant="primary" />
    <a href={toolUrl(tool.slug)} class="btn btn-ghost">Read the {tool.name} review</a>
  </div>
</article>

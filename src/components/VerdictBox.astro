---
interface Props {
  /** Small label above the verdict. */
  label?: string;
  /** Optional score to show alongside. */
  score?: number;
  class?: string;
}

import { score1 } from '../lib/format';

const { label = 'The verdict', score, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'border-l-[6px] border-yellow bg-white p-5 sm:p-6',
    'border-y border-r border-line',
    className,
  ]}
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <p class="eyebrow">{label}</p>
    {
      score !== undefined && (
        <p class="flex items-baseline gap-1.5 font-condensed leading-none">
          <span class="text-3xl font-bold text-ink">{score1(score)}</span>
          <span class="text-base font-semibold text-ink-muted">/ 10</span>
        </p>
      )
    }
  </div>
  <div class="mt-3 text-[1.15rem] leading-relaxed text-ink">
    <slot />
  </div>
</div>

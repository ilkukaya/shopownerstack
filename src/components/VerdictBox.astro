---
import ScoreBadge from './ScoreBadge.astro';

interface Props {
  /** Small label above the verdict. */
  label?: string;
  /** Optional score to show alongside. */
  score?: number;
  class?: string;
}

const { label = 'Our verdict', score, class: className = '' } = Astro.props;
---

<div class:list={['card relative overflow-hidden p-5 sm:p-6', className]}>
  <span class="absolute inset-y-0 left-0 w-1.5 bg-brand" aria-hidden="true"></span>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <p class="kicker">{label}</p>
      <div class="mt-2 text-[1.1rem] leading-relaxed text-ink" data-answer>
        <slot />
      </div>
    </div>
    {score !== undefined && <ScoreBadge score={score} size="lg" class="hidden sm:inline-flex" />}
  </div>
</div>

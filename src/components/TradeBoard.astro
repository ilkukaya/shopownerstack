---
import TradeIcon from './TradeIcon.astro';
import { bestUrl } from '../lib/urls';
import { CATEGORY_META, type Category } from '../lib/site';

interface Props {
  trades: {
    name: string;
    slug: string;
    icon: string;
    category: Category;
    description: string;
  }[];
  toolCounts: Record<string, number>;
}

const { trades, toolCounts } = Astro.props;
---

<ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
  {
    trades.map((trade) => (
      <li>
        <a
          href={bestUrl(trade.category, trade.slug)}
          class="card card-link group flex h-full flex-col gap-3 p-4 no-underline sm:p-5"
        >
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-wash text-brand transition-colors group-hover:bg-brand group-hover:text-white">
            <TradeIcon name={trade.icon} class="h-6 w-6" />
          </span>
          <span>
            <span class="block text-[1.05rem] font-semibold leading-tight text-ink">{trade.name}</span>
            <span class="mt-1 block text-sm leading-snug text-ink-muted">
              {toolCounts[trade.slug] ?? 0} {CATEGORY_META[trade.category].label.toLowerCase().replace(' software', '')} tools compared
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

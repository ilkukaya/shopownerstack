---
import TradeIcon from './TradeIcon.astro';
import { bestUrl } from '../lib/urls';
import { CATEGORY_META, type Category } from '../lib/site';

interface Props {
  trades: {
    name: string;
    slug: string;
    icon: string;
    category: Category;
    description: string;
  }[];
  toolCounts: Record<string, number>;
}

const { trades, toolCounts } = Astro.props;
---

<ul class="grid grid-cols-1 gap-px border border-ink bg-ink sm:grid-cols-2 lg:grid-cols-4">
  {
    trades.map((trade) => (
      <li>
        <a
          href={bestUrl(trade.category, trade.slug)}
          class="group flex h-full flex-col gap-3 bg-white p-5 no-underline transition-colors hover:bg-yellow"
        >
          <span class="flex items-center justify-between">
            <TradeIcon name={trade.icon} class="h-8 w-8 text-ink" />
            <span class="font-condensed text-sm font-bold uppercase tracking-[0.12em] text-ink-muted group-hover:text-ink">
              {toolCounts[trade.slug] ?? 0} tested
            </span>
          </span>
          <span class="font-condensed text-2xl font-bold uppercase leading-none text-ink">
            {trade.name}
          </span>
          <span class="text-sm leading-snug text-ink-soft group-hover:text-ink">
            Best {CATEGORY_META[trade.category].label.toLowerCase()}
          </span>
        </a>
      </li>
    ))
  }
</ul>

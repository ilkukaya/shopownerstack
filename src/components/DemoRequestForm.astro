---
import { getCollection } from 'astro:content';
import { TEAM_SIZES, TEAM_SIZE_LABELS, DISCLOSURE } from '../lib/site';

interface Props {
  /** Tool this request is for. Submitted as a hidden field so leads are attributable. */
  provider: string;
  providerSlug: string;
  heading?: string;
  intro?: string;
}

const { provider, providerSlug, heading, intro } = Astro.props;

const trades = (await getCollection('trades')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

const formId = `demo-${providerSlug}`;
---

<!--
  PARTNERSTACK SLOT
  =================
  For now this posts to Netlify Forms (data-netlify="true"), so submissions are
  captured in the Netlify dashboard from day one and nothing is lost.

  To swap in a PartnerStack (or vendor) lead-form embed for a single tool:

    1. Add the embed markup inside the <div data-partnerstack-slot> below.
    2. Delete or hide the <form> beneath it - do not run both, or a lead is
       submitted twice and attribution breaks.
    3. Keep the disclosure paragraph. It has to stay visible under whichever
       form is live.

  Per-tool control belongs here rather than in content, so an embed change never
  requires a schema change.
-->
<section
  id="demo-request"
  class="on-ink scroll-mt-8 bg-ink text-white"
  aria-labelledby={`${formId}-heading`}
>
  <div class="hazard" aria-hidden="true"></div>
  <div class="wrap py-12">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.15fr]">
      <div>
        <p class="eyebrow">Talk to {provider}</p>
        <h2 id={`${formId}-heading`} class="mt-3 font-condensed text-4xl font-bold uppercase leading-none">
          {heading ?? `Book a ${provider} demo`}
        </h2>
        <p class="mt-4 max-w-md text-white/75">
          {
            intro ??
              `Tell us about the shop and we will pass it to ${provider} so the demo is about your work rather than a generic tour. No obligation, and we do not sell your details on.`
          }
        </p>
      </div>

      <div data-partnerstack-slot>
        {/* PartnerStack embed goes here. See the comment above this section. */}

        <form
          name="demo-request"
          id={formId}
          method="POST"
          data-netlify="true"
          netlify-honeypot="company-website"
          action="/thanks/"
          class="board bg-white p-5 text-ink sm:p-6"
        >
          <input type="hidden" name="form-name" value="demo-request" />
          <input type="hidden" name="provider" value={provider} />
          <input type="hidden" name="provider-slug" value={providerSlug} />

          {/* Honeypot: hidden from people, tempting to bots. */}
          <p class="hidden" aria-hidden="true">
            <label>Do not fill this in <input name="company-website" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for={`${formId}-name`} class="block font-condensed text-sm font-bold uppercase tracking-[0.12em]">
                Your name
              </label>
              <input
                type="text"
                id={`${formId}-name`}
                name="name"
                required
                autocomplete="name"
                class="mt-1.5 w-full border border-line bg-paper px-3 py-2.5 text-ink"
              />
            </div>

            <div class="sm:col-span-2">
              <label for={`${formId}-business`} class="block font-condensed text-sm font-bold uppercase tracking-[0.12em]">
                Business name
              </label>
              <input
                type="text"
                id={`${formId}-business`}
                name="business-name"
                required
                autocomplete="organization"
                class="mt-1.5 w-full border border-line bg-paper px-3 py-2.5 text-ink"
              />
            </div>

            <div>
              <label for={`${formId}-email`} class="block font-condensed text-sm font-bold uppercase tracking-[0.12em]">
                Email
              </label>
              <input
                type="email"
                id={`${formId}-email`}
                name="email"
                required
                autocomplete="email"
                class="mt-1.5 w-full border border-line bg-paper px-3 py-2.5 text-ink"
              />
            </div>

            <div>
              <label for={`${formId}-phone`} class="block font-condensed text-sm font-bold uppercase tracking-[0.12em]">
                Phone
              </label>
              <input
                type="tel"
                id={`${formId}-phone`}
                name="phone"
                required
                autocomplete="tel"
                class="mt-1.5 w-full border border-line bg-paper px-3 py-2.5 text-ink"
              />
            </div>

            <div>
              <label for={`${formId}-trade`} class="block font-condensed text-sm font-bold uppercase tracking-[0.12em]">
                Trade
              </label>
              <select
                id={`${formId}-trade`}
                name="trade"
                required
                class="mt-1.5 w-full border border-line bg-paper px-3 py-2.5 text-ink"
              >
                <option value="">Select a trade</option>
                {trades.map((trade) => <option value={trade.data.slug}>{trade.data.name}</option>)}
                <option value="other">Something else</option>
              </select>
            </div>

            <div>
              <label for={`${formId}-size`} class="block font-condensed text-sm font-bold uppercase tracking-[0.12em]">
                Team size
              </label>
              <select
                id={`${formId}-size`}
                name="team-size"
                required
                class="mt-1.5 w-full border border-line bg-paper px-3 py-2.5 text-ink"
              >
                <option value="">Select a size</option>
                {TEAM_SIZES.map((size) => <option value={size}>{TEAM_SIZE_LABELS[size]}</option>)}
              </select>
            </div>
          </div>

          <button type="submit" class="btn btn-primary mt-5 w-full sm:w-auto">
            Request a demo
          </button>

          <p class="mt-3 text-sm leading-snug text-ink-muted">{DISCLOSURE}</p>
        </form>
      </div>
    </div>
  </div>
</section>

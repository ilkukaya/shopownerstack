---
interface Props {
  items: { name: string; path: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="wrap pt-5">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[0.8125rem]">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && (
            <svg class="h-3 w-3 text-ink-muted/60" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
          )}
          {i === items.length - 1 ? (
            <span class="font-medium text-ink-soft" aria-current="page">{item.name}</span>
          ) : (
            <a href={item.path} class="text-ink-muted no-underline hover:text-brand hover:underline">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

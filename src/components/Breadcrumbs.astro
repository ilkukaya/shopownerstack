---
interface Props {
  items: { name: string; path: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="border-b border-line bg-paper-deep/50">
  <ol class="wrap flex flex-wrap items-center gap-x-2 gap-y-1 py-2.5 text-sm">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && (
            <span class="text-ink-muted" aria-hidden="true">
              /
            </span>
          )}
          {i === items.length - 1 ? (
            <span class="font-semibold text-ink" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.path} class="text-ink-muted underline-offset-2 hover:text-ink hover:underline">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

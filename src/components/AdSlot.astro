---
import { ADSENSE_CLIENT, IS_INDEXABLE } from '../lib/site';

interface Props {
  /** AdSense ad unit id (data-ad-slot). Without one, AdSense auto ads decide placement. */
  slot?: string;
  class?: string;
}

const { slot = import.meta.env.PUBLIC_ADSENSE_SLOT_INARTICLE ?? '', class: className = '' } = Astro.props;
const show = Boolean(ADSENSE_CLIENT) && Boolean(slot) && IS_INDEXABLE;
---

{
  show && (
    <aside class:list={['my-10', className]} aria-label="Advertisement">
      <ins
        class="adsbygoogle ad-slot"
        style="display:block"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </aside>
  )
}

---
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<span class="flex items-center gap-2.5">
  <svg class="h-8 w-8 flex-none" viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="14" fill="#0B6B4F"></rect>
    <rect x="14" y="14" width="36" height="9" rx="4.5" fill="#fff"></rect>
    <rect x="14" y="27.5" width="26" height="9" rx="4.5" fill="#fff" opacity=".85"></rect>
    <rect x="14" y="41" width="36" height="9" rx="4.5" fill="#F2A900"></rect>
  </svg>
  <span
    class:list={[
      'text-[1.15rem] font-bold leading-none tracking-[-0.02em]',
      dark ? 'text-white' : 'text-ink',
    ]}
  >
    ShopOwner<span class={dark ? 'text-[#8fdcbc]' : 'text-brand'}>Stack</span>
  </span>
</span>

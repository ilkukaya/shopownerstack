---
interface Props {
  getItIf: string[];
  skipItIf: string[];
  name: string;
}

const { getItIf, skipItIf, name } = Astro.props;
---

<div class="grid gap-4 md:grid-cols-2">
  <section class="rounded-[14px] border border-good/20 bg-good-wash p-5">
    <h3 class="font-sans text-base font-semibold text-good">Choose {name} if</h3>
    <ul class="mt-3 space-y-2.5">
      {
        getItIf.map((item) => (
          <li class="flex gap-2.5 leading-snug text-ink-soft">
            <svg class="mt-0.5 h-4.5 w-4.5 flex-none text-good" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.5 8.5 6 12l7.5-8" />
            </svg>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="rounded-[14px] border border-bad/15 bg-bad-wash p-5">
    <h3 class="font-sans text-base font-semibold text-bad">Look elsewhere if</h3>
    <ul class="mt-3 space-y-2.5">
      {
        skipItIf.map((item) => (
          <li class="flex gap-2.5 leading-snug text-ink-soft">
            <svg class="mt-0.5 h-4.5 w-4.5 flex-none text-bad" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4l8 8M12 4l-8 8" />
            </svg>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </section>
</div>

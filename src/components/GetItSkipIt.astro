---
interface Props {
  getItIf: string[];
  skipItIf: string[];
  name: string;
}

const { getItIf, skipItIf, name } = Astro.props;
---

<div class="grid gap-5 md:grid-cols-2">
  <section class="board border-t-4 border-t-good p-5">
    <h3 class="font-condensed text-xl font-bold uppercase tracking-wide text-good">
      Get {name} if
    </h3>
    <ul class="mt-3 space-y-2.5">
      {
        getItIf.map((item) => (
          <li class="flex gap-2.5 leading-snug">
            <svg
              class="mt-1 h-4 w-4 flex-none text-good"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2.5 8.5 6 12l7.5-8" />
            </svg>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="board border-t-4 border-t-bad p-5">
    <h3 class="font-condensed text-xl font-bold uppercase tracking-wide text-bad">
      Skip {name} if
    </h3>
    <ul class="mt-3 space-y-2.5">
      {
        skipItIf.map((item) => (
          <li class="flex gap-2.5 leading-snug">
            <svg
              class="mt-1 h-4 w-4 flex-none text-bad"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 4l8 8M12 4l-8 8" />
            </svg>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </section>
</div>

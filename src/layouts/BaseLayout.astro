---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, GA_ID, ADSENSE_CLIENT, IS_INDEXABLE, VERIFY } from '../lib/site';
import { graph } from '../lib/schema';

// Preloaded so the two faces that carry almost all visible text arrive before
// first paint, which keeps the fallback-to-webfont swap from shifting layout.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Site-relative path of this page, used for the canonical and og:url. */
  path: string;
  /** JSON-LD nodes for the @graph. BreadcrumbList belongs on every page. */
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  /** Site-relative path of a 1200x630 PNG. Defaults to the generic card. */
  ogImage?: string;
  noindex?: boolean;
  /** Load the AdSense script on this page (only when PUBLIC_ADSENSE_CLIENT is set). */
  ads?: boolean;
  /** ISO dates for article:published_time / modified_time. */
  published?: Date;
  modified?: Date;
}

const {
  title,
  description,
  path,
  jsonLd = [],
  ogType = 'website',
  ogImage = '/og/default.png',
  noindex = false,
  ads = false,
  published,
  modified,
} = Astro.props;

const canonical = new URL(path, Astro.site ?? SITE.url).toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE.url).toString();
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const robots = noindex || !IS_INDEXABLE ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';
const loadAds = ads && Boolean(ADSENSE_CLIENT) && IS_INDEXABLE;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0B6B4F" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site summary" />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {VERIFY.google && <meta name="google-site-verification" content={VERIFY.google} />}
    {VERIFY.bing && <meta name="msvalidate.01" content={VERIFY.bing} />}

    {jsonLd.length > 0 && <script is:inline type="application/ld+json" set:html={graph(jsonLd)} />}

    {
      /* GA4 is only loaded when PUBLIC_GA_ID is set, so local and preview builds
         ship no analytics JS at all. */
      GA_ID && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script is:inline define:vars={{ GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', GA_ID);
          </script>
        </>
      )
    }

    {
      /* AdSense: only on pages that opt in, only in production, only when the
         publisher id is configured. Consent for EEA/UK visitors is handled by
         Google's own CMP (AdSense > Privacy & messaging), which needs no code. */
      loadAds && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="flex-1" data-pagefind-body={noindex ? undefined : ""}>
      <slot />
    </main>
    <Footer />

    <script is:inline define:vars={{ GA_ID }}>
      // ---------------------------------------------------------------------
      // Affiliate click tracking. Every outbound tool link is a /go/<slug>/
      // link. We fire the GA4 event before the browser leaves the page;
      // sendBeacon is the fallback because a normal gtag() call can be
      // cancelled by the navigation.
      // ---------------------------------------------------------------------
      (function () {
        if (!GA_ID) return;

        document.addEventListener(
          'click',
          function (event) {
            var link = event.target instanceof Element ? event.target.closest('a[href*="/go/"]') : null;
            if (!link) return;

            var path = new URL(link.href, location.origin).pathname;
            var match = path.match(/^\/go\/([^/]+)\/?$/);
            if (!match) return;

            var payload = {
              tool: match[1],
              page: location.pathname,
              placement: link.getAttribute('data-placement') || 'inline',
              transport_type: 'beacon',
            };

            if (typeof window.gtag === 'function') {
              window.gtag('event', 'affiliate_click', payload);
            } else if (navigator.sendBeacon) {
              try {
                navigator.sendBeacon(
                  'https://www.google-analytics.com/g/collect?v=2&tid=' +
                    encodeURIComponent(GA_ID) +
                    '&en=affiliate_click&ep.tool=' +
                    encodeURIComponent(payload.tool) +
                    '&ep.page=' +
                    encodeURIComponent(payload.page),
                );
              } catch (e) {
                /* tracking must never block the click */
              }
            }
          },
          { capture: true },
        );
      })();
    </script>
  </body>
</html>

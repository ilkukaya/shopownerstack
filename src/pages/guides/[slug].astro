---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import UpdatedMeta from '../../components/UpdatedMeta.astro';
import VerdictBox from '../../components/VerdictBox.astro';
import Faq from '../../components/Faq.astro';
import Sources from '../../components/Sources.astro';
import AdSlot from '../../components/AdSlot.astro';
import { guideUrl, CALCULATOR_URL } from '../../lib/urls';
import { formatDate } from '../../lib/format';
import { breadcrumbs, article, faqPage } from '../../lib/schema';
import type { Guide } from '../../lib/content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.data.slug }, props: { guide } }));
}

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const g = guide.data;
const { Content, headings } = await render(guide);

const others = (await getCollection('guides'))
  .filter((x) => x.data.slug !== g.slug)
  .sort((a, b) => b.data.updatedDate.getTime() - a.data.updatedDate.getTime())
  .slice(0, 3);

const path = guideUrl(g.slug);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
  { name: g.title, path },
];
const toc = headings.filter((h) => h.depth === 2);
const ogImage = `/og/guides/${g.slug}.png`;
---

<BaseLayout
  title={g.title}
  description={g.description}
  path={path}
  ogType="article"
  ogImage={ogImage}
  ads
  published={g.publishDate}
  modified={g.updatedDate}
  jsonLd={[
    breadcrumbs(crumbs),
    article({
      title: g.title,
      description: g.description,
      path,
      publishDate: g.publishDate,
      updatedDate: g.updatedDate,
      image: ogImage,
    }),
    ...(g.faq.length ? [faqPage(g.faq)] : []),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <article class="wrap-narrow pt-6 sm:pt-8">
    <p class="kicker">Guide</p>
    <h1 class="mt-3 text-[2.1rem] leading-[1.12] sm:text-[2.75rem]">{g.title}</h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-soft">{g.description}</p>
    <UpdatedMeta updatedDate={g.updatedDate} class="mt-5" />

    <VerdictBox label="Key takeaway" class="mt-7">
      <p>{g.summary}</p>
    </VerdictBox>

    {
      toc.length > 2 && (
        <nav class="card mt-7 p-5" aria-label="In this guide">
          <p class="text-sm font-semibold text-ink">In this guide</p>
          <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-[0.95rem] marker:text-ink-muted">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-ink-soft no-underline hover:text-brand hover:underline">{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose-shop mt-10">
      <Content />
    </div>

    <AdSlot />

    <Faq items={g.faq} />
    <Sources sources={g.sources} />

    <p class="mt-10 text-sm text-ink-muted">
      First published <time datetime={g.publishDate.toISOString().slice(0, 10)}>{formatDate(g.publishDate)}</time>.
      Found an error? <a href="/contact/" class="underline underline-offset-2">Tell us</a> and we will fix it.
    </p>
  </article>

  <section class="wrap mt-16" aria-labelledby="more-heading">
    <h2 id="more-heading" class="section-title">More guides</h2>
    <ul class="mt-5 grid gap-4 md:grid-cols-3">
      {
        others.map((o) => (
          <li>
            <a href={guideUrl(o.data.slug)} class="card card-link flex h-full flex-col p-5 no-underline">
              <h3 class="text-lg leading-snug text-ink">{o.data.title}</h3>
              <p class="mt-2 flex-1 text-[0.95rem] leading-snug text-ink-soft">{o.data.description}</p>
              <span class="mt-4 text-sm font-semibold text-brand">Read guide <span aria-hidden="true">&rarr;</span></span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="card mt-4 flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-semibold text-ink">What should you charge per hour? Work it out in two minutes.</p>
      <a href={CALCULATOR_URL} class="btn btn-secondary">Open the rate calculator</a>
    </div>
  </section>

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

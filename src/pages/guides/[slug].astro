---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { guideUrl } from '../../lib/urls';
import { formatDate } from '../../lib/format';
import { breadcrumbs, article } from '../../lib/schema';
import type { Guide } from '../../lib/content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.data.slug }, props: { guide } }));
}

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const g = guide.data;
const { Content } = await render(guide);

const others = (await getCollection('guides'))
  .filter((x) => x.data.slug !== g.slug)
  .sort((a, b) => b.data.updatedDate.getTime() - a.data.updatedDate.getTime())
  .slice(0, 3);

const path = guideUrl(g.slug);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
  { name: g.title, path },
];
---

<BaseLayout
  title={g.title}
  description={g.description}
  path={path}
  ogType="article"
  jsonLd={[
    breadcrumbs(crumbs),
    article({
      title: g.title,
      description: g.description,
      path,
      publishDate: g.publishDate,
      updatedDate: g.updatedDate,
    }),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <article class="wrap-narrow pt-8">
    <p class="eyebrow">Guide</p>
    <h1 class="mt-3 font-condensed text-5xl font-bold uppercase leading-none sm:text-6xl">
      {g.title}
    </h1>

    <!-- The description is the verdict: the direct answer, right after the H1. -->
    <p class="mt-5 border-l-[6px] border-yellow bg-white p-5 text-[1.15rem] leading-relaxed">
      {g.description}
    </p>

    <p class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-ink-muted">
      <span>
        Published <time datetime={g.publishDate.toISOString().slice(0, 10)}>
          {formatDate(g.publishDate)}
        </time>
      </span>
      <span>
        Last updated <time datetime={g.updatedDate.toISOString().slice(0, 10)}>
          {formatDate(g.updatedDate)}
        </time>
      </span>
    </p>

    <div class="prose-shop mt-10">
      <Content />
    </div>
  </article>

  <section class="wrap mt-16" aria-labelledby="more-heading">
    <h2 id="more-heading" class="font-condensed text-3xl font-bold uppercase sm:text-4xl">
      More guides
    </h2>
    <ul class="mt-5 grid gap-5 md:grid-cols-3">
      {
        others.map((other) => (
          <li>
            <a
              href={guideUrl(other.data.slug)}
              class="board flex h-full flex-col p-5 no-underline hover:border-ink"
            >
              <h3 class="font-condensed text-xl font-bold uppercase leading-tight">
                {other.data.title}
              </h3>
              <p class="mt-2 text-[0.95rem] leading-snug text-ink-soft">{other.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

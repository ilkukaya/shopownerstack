---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerdictBox from '../../components/VerdictBox.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { guideUrl, CALCULATOR_URL } from '../../lib/urls';
import { formatDate } from '../../lib/format';
import { breadcrumbs } from '../../lib/schema';

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.updatedDate.getTime() - a.data.updatedDate.getTime(),
);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
];
---

<BaseLayout
  title="Guides for shop owners"
  description="Pricing, switching software, missed calls, no-shows and contract terms - the money questions behind the software, answered without a sales pitch."
  path="/guides/"
  jsonLd={[breadcrumbs(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <div class="wrap pt-8">
    <h1 class="font-condensed text-5xl font-bold uppercase leading-none sm:text-6xl">Guides</h1>

    <VerdictBox class="mt-6" label="The short answer">
      <p>
        Software is rarely the actual problem. These guides cover the things underneath it -
        what to charge, what a missed call costs, how to switch without losing a month, and
        which contract terms matter before you sign.
      </p>
    </VerdictBox>
  </div>

  <section class="wrap mt-10" aria-label="All guides">
    <ul class="grid gap-5 md:grid-cols-2">
      {
        guides.map((guide) => (
          <li>
            <a
              href={guideUrl(guide.data.slug)}
              class="board flex h-full flex-col p-5 no-underline transition-colors hover:border-ink"
            >
              <h2 class="font-condensed text-2xl font-bold uppercase leading-tight">
                {guide.data.title}
              </h2>
              <p class="mt-2 flex-1 leading-snug text-ink-soft">{guide.data.description}</p>
              <p class="mt-3 text-xs font-semibold uppercase tracking-[0.12em] text-ink-muted">
                Updated {formatDate(guide.data.updatedDate)}
              </p>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="board mt-8 flex flex-wrap items-center justify-between gap-4 border-l-[6px] border-l-yellow p-5">
      <div>
        <h2 class="font-condensed text-2xl font-bold uppercase leading-none">
          Work out your hourly rate first
        </h2>
        <p class="mt-2 max-w-xl text-ink-soft">
          Most of these guides assume you know what an hour of your time costs. If you do not,
          start here.
        </p>
      </div>
      <a href={CALCULATOR_URL} class="btn btn-primary">Job pricing calculator</a>
    </div>
  </section>

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

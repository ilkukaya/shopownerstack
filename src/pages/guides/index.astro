---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { guideUrl, CALCULATOR_URL } from '../../lib/urls';
import { formatDate } from '../../lib/format';
import { breadcrumbs, itemList, webPage } from '../../lib/schema';

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.updatedDate.getTime() - a.data.updatedDate.getTime(),
);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
];
const title = 'Guides for running a service business';
const description =
  'Practical guides on pricing jobs, cutting no-shows, missed calls, software contracts and switching tools, written for owners of small service businesses.';
---

<BaseLayout
  title={title}
  description={description}
  path="/guides/"
  jsonLd={[
    webPage({ path: '/guides/', title, description, type: 'CollectionPage' }),
    breadcrumbs(crumbs),
    itemList(title, guides.map((g) => ({ name: g.data.title, path: guideUrl(g.data.slug) }))),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <header class="wrap pt-6 sm:pt-8">
    <p class="kicker">Guides</p>
    <h1 class="mt-3 max-w-3xl text-[2.1rem] leading-[1.1] sm:text-5xl">The money questions, answered plainly</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{description}</p>
  </header>

  <section class="wrap mt-10">
    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        guides.map((guide) => (
          <li>
            <a href={guideUrl(guide.data.slug)} class="card card-link flex h-full flex-col p-6 no-underline">
              <h2 class="text-xl leading-snug text-ink">{guide.data.title}</h2>
              <p class="mt-3 flex-1 leading-relaxed text-ink-soft">{guide.data.description}</p>
              <p class="mt-5 flex items-center justify-between text-sm">
                <span class="text-ink-muted">Updated {formatDate(guide.data.updatedDate)}</span>
                <span class="font-semibold text-brand">Read <span aria-hidden="true">&rarr;</span></span>
              </p>
            </a>
          </li>
        ))
      }
      <li>
        <a href={CALCULATOR_URL} class="card card-link flex h-full flex-col bg-brand-wash p-6 no-underline">
          <p class="kicker">Free tool</p>
          <h2 class="mt-2 text-xl leading-snug text-ink">Hourly rate and job pricing calculator</h2>
          <p class="mt-3 flex-1 leading-relaxed text-ink-soft">Work out the rate that covers your overhead, billable hours and the income you want.</p>
          <span class="mt-5 text-sm font-semibold text-brand">Open calculator <span aria-hidden="true">&rarr;</span></span>
        </a>
      </li>
    </ul>
  </section>

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

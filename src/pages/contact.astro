---
import ProseLayout from '../layouts/ProseLayout.astro';

const field = 'mt-1.5 w-full rounded-[10px] border border-line-strong bg-white px-3.5 py-2.5 text-ink shadow-sm';
const labelCls = 'block text-sm font-semibold text-ink';
---

<ProseLayout
  title="Contact us"
  kicker="Contact"
  type="ContactPage"
  path="/contact/"
  description="Corrections, questions about a review, partnership enquiries or privacy requests: send us a message and we will reply by email."
>
  <p>
    <strong>Found an out-of-date price or a factual error?</strong> Tell us which page and what has
    changed, ideally with a link to the source. Corrections are our top priority.
  </p>
  <p>
    <strong>Vendors:</strong> we are happy to hear about factual errors and new features. We do not
    accept payment for reviews, ratings or placement.
  </p>

  <form
    slot="after"
    name="contact"
    method="POST"
    data-netlify="true"
    netlify-honeypot="company-website"
    action="/thanks/"
    class="card mt-10 grid gap-5 p-5 sm:grid-cols-2 sm:p-7"
  >
    <input type="hidden" name="form-name" value="contact" />
    <p class="hidden" aria-hidden="true">
      <label>Do not fill this in <input name="company-website" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div>
      <label for="c-name" class={labelCls}>Your name</label>
      <input id="c-name" name="name" type="text" autocomplete="name" required class={field} />
    </div>
    <div>
      <label for="c-email" class={labelCls}>Email</label>
      <input id="c-email" name="email" type="email" autocomplete="email" required class={field} />
    </div>
    <div class="sm:col-span-2">
      <label for="c-topic" class={labelCls}>Topic</label>
      <select id="c-topic" name="topic" required class={field}>
        <option value="correction">Correction or out-of-date information</option>
        <option value="question">Question about a review</option>
        <option value="vendor">Vendor or partnership enquiry</option>
        <option value="privacy">Privacy request</option>
        <option value="other">Something else</option>
      </select>
    </div>
    <div class="sm:col-span-2">
      <label for="c-message" class={labelCls}>Message</label>
      <textarea id="c-message" name="message" rows="6" required class={field}></textarea>
    </div>
    <div class="sm:col-span-2 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-ink-muted">We use your details only to reply. See our <a href="/privacy/" class="underline">privacy policy</a>.</p>
      <button type="submit" class="btn btn-primary">Send message</button>
    </div>
  </form>
</ProseLayout>

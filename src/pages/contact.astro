---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import VerdictBox from '../components/VerdictBox.astro';
import { SITE } from '../lib/site';
import { breadcrumbs } from '../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
---

<BaseLayout
  title="Contact"
  description="Corrections, test requests, vendor enquiries and press. How to reach ShopOwnerStack and what to expect back."
  path="/contact/"
  jsonLd={[breadcrumbs(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <div class="wrap pt-8">
    <h1 class="font-condensed text-5xl font-bold uppercase leading-none sm:text-6xl">Contact</h1>

    <VerdictBox class="mt-6" label="The short answer">
      <p>
        Email <a
          href={`mailto:${SITE.email}`}
          class="underline decoration-yellow decoration-[3px] underline-offset-2">{SITE.email}</a
        >. Corrections are prioritised over everything else and get a reply within two working
        days.
      </p>
    </VerdictBox>
  </div>

  <section class="wrap mt-10" aria-label="Reasons to get in touch">
    <ul class="grid gap-5 md:grid-cols-2">
      <li class="board border-t-4 border-t-yellow p-5">
        <h2 class="font-condensed text-2xl font-bold uppercase leading-none">
          Something here is wrong
        </h2>
        <p class="mt-3 text-ink-soft">
          Tell us which page and what the correct figure is. We re-run the specific test rather
          than editing the page from an email. If we got it wrong, the page is corrected and the
          correction is dated on it.
        </p>
      </li>

      <li class="board border-t-4 border-t-ink p-5">
        <h2 class="font-condensed text-2xl font-bold uppercase leading-none">
          Test this product
        </h2>
        <p class="mt-3 text-ink-soft">
          Tell us what you run, how many people you have and what you are using now. Requests from
          shop owners carry far more weight than requests from vendors, and we prioritise products
          several readers ask about.
        </p>
      </li>

      <li class="board border-t-4 border-t-ink p-5">
        <h2 class="font-condensed text-2xl font-bold uppercase leading-none">Vendors</h2>
        <p class="mt-3 text-ink-soft">
          We buy our own subscriptions and do not accept free accounts for scoring, review copy,
          or pre-publication review. If a result is wrong we will re-test it. Partner programme
          details are welcome and go to a different inbox from editorial.
        </p>
      </li>

      <li class="board border-t-4 border-t-ink p-5">
        <h2 class="font-condensed text-2xl font-bold uppercase leading-none">Press and data</h2>
        <p class="mt-3 text-ink-soft">
          Our measurements are free to cite with a link. If you want the underlying figures behind
          a chart or a comparison table, ask and we will send them.
        </p>
      </li>
    </ul>

    <div class="board mt-8 p-6 text-center">
      <p class="font-condensed text-sm font-bold uppercase tracking-[0.14em] text-ink-muted">
        One address for all of it
      </p>
      <p class="mt-2">
        <a
          href={`mailto:${SITE.email}`}
          class="font-condensed text-3xl font-bold uppercase underline decoration-yellow decoration-4 underline-offset-4 sm:text-4xl"
          >{SITE.email}</a
        >
      </p>
      <p class="mt-3 text-sm text-ink-muted">
        We read everything. Corrections get a reply within two working days; everything else may
        take a week.
      </p>
    </div>
  </section>
</BaseLayout>

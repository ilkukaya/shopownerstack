---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerdictBox from '../../components/VerdictBox.astro';
import UpdatedMeta from '../../components/UpdatedMeta.astro';
import Faq from '../../components/Faq.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import TradeIcon from '../../components/TradeIcon.astro';
import { money } from '../../lib/format';
import { CALCULATOR_URL, guideUrl } from '../../lib/urls';
import { breadcrumbs, faqPage, abs } from '../../lib/schema';

const trades = await getCollection('trades');

// Passed to the client script so the trade selector can prefill benchmarks.
const benchmarks = Object.fromEntries(
  trades.map((t) => [
    t.data.slug,
    {
      name: t.data.name,
      rate: t.data.typicalHourlyRate,
      overheadPerHour: t.data.overheadPerHourSolo,
    },
  ]),
);

const faqItems = [
  {
    q: 'What hourly rate should a small service business charge?',
    a: 'Enough to cover annual overhead, the income you need to take out and a target profit, divided by the hours you can actually bill. For most solo trades that lands well above the rate they are charging, because they divide by hours worked rather than hours billed.',
  },
  {
    q: 'How many hours a year can a solo operator actually bill?',
    a: 'Usually 55 to 65 percent of hours worked. Quoting, driving, invoicing, chasing payment and buying parts are all real work and none of it is chargeable. A 45-hour week over 48 weeks is 2,160 hours worked and roughly 1,200 to 1,400 billable.',
  },
  {
    q: 'Should materials be included in the hourly rate?',
    a: 'No. Price labour by the hour and materials separately with a markup that varies by cost band, so cheap parts carry a higher percentage than expensive ones. Handling a four dollar fitting costs about the same as handling a four hundred dollar unit.',
  },
  {
    q: 'What counts as overhead?',
    a: 'Everything that is not the labour on the job: vehicle and fuel, insurance, software subscriptions, phone, accountant, rent, tools, marketing, bank and card fees. Most owners under-count it by about a third because the small recurring subscriptions get forgotten.',
  },
];

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Hourly rate calculator', path: CALCULATOR_URL },
];

const title = 'Hourly Rate Calculator for Service Businesses (Free)';
const description =
  'Free hourly rate calculator for plumbers, electricians, cleaners and other service businesses. Work out the rate that covers overhead, your income and a profit, then compare it with published rates for your trade.';

const webApp = {
  '@type': 'WebApplication',
  name: 'Hourly rate and job pricing calculator',
  url: abs(CALCULATOR_URL),
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any (web browser)',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
  description,
};

const updated = trades.map((t) => t.data).length ? new Date('2026-09-26') : new Date();

const field = 'mt-1.5 w-full rounded-[10px] border border-line-strong bg-white px-3.5 py-2.5 text-ink tabular-nums shadow-sm focus:border-brand';
const labelCls = 'block text-sm font-semibold text-ink';
---

<BaseLayout
  title={title}
  description={description}
  path={CALCULATOR_URL}
  ogImage="/og/calculator.png"
  jsonLd={[breadcrumbs(crumbs), webApp, faqPage(faqItems)]}
>
  <Breadcrumbs items={crumbs} />

  <header class="wrap pt-6 sm:pt-8">
    <div class="max-w-3xl">
      <p class="kicker">Free tool</p>
      <h1 class="mt-3 text-[2.1rem] leading-[1.1] sm:text-5xl">Hourly rate calculator for service businesses</h1>
      <UpdatedMeta updatedDate={updated} class="mt-5" />
    </div>
    <VerdictBox class="mt-7 max-w-4xl" label="Quick answer">
      <p>
        Your hourly rate should be annual overhead plus the income you need plus a target profit,
        divided by the hours you can actually bill, not the hours you work. Put your own numbers in
        below; most owners find they are undercharging.
      </p>
    </VerdictBox>
  </header>

  <section class="wrap mt-10" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="sr-only">Calculator</h2>

    <form class="grid gap-6 lg:grid-cols-[1fr_22rem]" id="rate-calc" novalidate>
      <div class="card p-5 sm:p-7">
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label for="calc-trade" class={labelCls}>Your trade (optional)</label>
            <select id="calc-trade" class={field}>
              <option value="">Choose a trade to compare</option>
              {trades.map((t) => <option value={t.data.slug}>{t.data.name}</option>)}
            </select>
          </div>

          <div>
            <label for="calc-overhead" class={labelCls}>Annual overhead ($)</label>
            <input type="number" id="calc-overhead" inputmode="numeric" min="0" step="500" value="46000" class={field} />
            <p class="mt-1 text-sm text-ink-muted">Vehicle, insurance, software, phone, rent, tools, marketing.</p>
          </div>

          <div>
            <label for="calc-income" class={labelCls}>Owner income you need ($)</label>
            <input type="number" id="calc-income" inputmode="numeric" min="0" step="1000" value="85000" class={field} />
            <p class="mt-1 text-sm text-ink-muted">What you need to take out of the business.</p>
          </div>

          <div>
            <label for="calc-profit" class={labelCls}>Target profit ($)</label>
            <input type="number" id="calc-profit" inputmode="numeric" min="0" step="1000" value="15000" class={field} />
            <p class="mt-1 text-sm text-ink-muted">Kept in the business for growth and bad months.</p>
          </div>

          <div>
            <label for="calc-hours" class={labelCls}>Hours worked per week</label>
            <input type="number" id="calc-hours" inputmode="numeric" min="1" max="100" step="1" value="45" class={field} />
          </div>

          <div>
            <label for="calc-weeks" class={labelCls}>Working weeks per year</label>
            <input type="number" id="calc-weeks" inputmode="numeric" min="1" max="52" step="1" value="48" class={field} />
          </div>

          <div>
            <label for="calc-utilisation" class={labelCls}>Billable share of hours (%)</label>
            <input type="number" id="calc-utilisation" inputmode="numeric" min="10" max="100" step="1" value="60" class={field} />
            <p class="mt-1 text-sm text-ink-muted">Quoting, driving and paperwork are not billable.</p>
          </div>
        </div>

        <p class="mt-6 flex items-center gap-2 border-t border-line pt-4 text-sm text-ink-muted">
          <svg class="h-4 w-4 flex-none" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5" /><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" /></svg>
          Everything is calculated in your browser. Nothing is sent or stored.
        </p>
      </div>

      <output for="rate-calc" class="on-dark block h-max rounded-[18px] bg-night p-6 text-white lg:sticky lg:top-24" aria-live="polite">
        <p class="kicker">Your minimum rate</p>
        <p class="mt-3 text-6xl font-bold tracking-tight tabular-nums" id="out-rate">$112</p>
        <p class="mt-1 text-sm text-white/65">per billable hour to hit all three targets</p>

        <dl class="mt-6 space-y-3 border-t border-white/15 pt-4 text-[0.95rem]">
          <div class="flex justify-between gap-3">
            <dt class="text-white/65">Billable hours a year</dt>
            <dd class="font-semibold tabular-nums" id="out-hours">1,296</dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-white/65">Overhead per billable hour</dt>
            <dd class="font-semibold tabular-nums" id="out-overhead">$36</dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-white/65">Break-even rate</dt>
            <dd class="font-semibold tabular-nums" id="out-breakeven">$101</dd>
          </div>
          <div class="flex justify-between gap-3 border-t border-white/15 pt-3">
            <dt class="text-white/65">Typical rate for trade</dt>
            <dd class="font-semibold tabular-nums" id="out-benchmark">Pick a trade</dd>
          </div>
        </dl>

        <p class="mt-5 rounded-xl bg-white/10 p-3.5 text-sm leading-snug text-white/90" id="out-note">
          Choose your trade to compare this with typical published rates.
        </p>
      </output>
    </form>
  </section>

  <section class="wrap mt-14" aria-labelledby="benchmarks-heading">
    <h2 id="benchmarks-heading" class="section-title">What do other trades charge per hour?</h2>
    <p class="mt-2 max-w-3xl text-ink-soft">
      Typical customer-facing hourly rates in the US, from published cost guides (linked). Rates vary
      widely by region, licensing and job type. The solo overhead column is our illustrative starting
      assumption for the calculator, not a statistic; replace it with your own figure.
    </p>

    <div class="table-scroll card mt-5">
      <table class="data-table min-w-[40rem]">
        <caption class="sr-only">Typical hourly rates by trade with sources</caption>
        <thead>
          <tr>
            <th scope="col">Trade</th>
            <th scope="col">Typical range</th>
            <th scope="col">Midpoint</th>
            <th scope="col">Illustrative solo overhead / hr</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          {
            trades.map((t) => (
              <tr>
                <th scope="row">
                  <span class="flex items-center gap-2.5 font-semibold text-ink">
                    <TradeIcon name={t.data.icon} class="h-5 w-5 text-brand" />
                    {t.data.name}
                  </span>
                </th>
                <td class="tabular-nums">{t.data.rateRange}</td>
                <td class="font-semibold tabular-nums">{money(t.data.typicalHourlyRate)}</td>
                <td class="tabular-nums text-ink-soft">{money(t.data.overheadPerHourSolo)}</td>
                <td class="text-sm">
                  <a href={t.data.rateSource.url} rel="nofollow noopener" target="_blank" class="text-ink-soft underline decoration-line-strong underline-offset-2 hover:text-brand">
                    {t.data.rateSource.title}
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <div class="wrap-narrow">
    <Faq items={faqItems} heading="Pricing questions" />

    <p class="mt-8">
      <a href={guideUrl('how-to-price-a-service-job')} class="btn btn-secondary">Read the full pricing guide</a>
    </p>
  </div>

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

<script is:inline define:vars={{ benchmarks }}>
  // Job pricing calculator. Plain JS, no framework, no network.
  (function () {
    var form = document.getElementById('rate-calc');
    if (!form) return;

    var ids = ['overhead', 'income', 'profit', 'hours', 'weeks', 'utilisation'];
    var inputs = {};
    ids.forEach(function (id) {
      inputs[id] = document.getElementById('calc-' + id);
    });
    var tradeSelect = document.getElementById('calc-trade');

    var out = {
      rate: document.getElementById('out-rate'),
      hours: document.getElementById('out-hours'),
      overhead: document.getElementById('out-overhead'),
      breakeven: document.getElementById('out-breakeven'),
      benchmark: document.getElementById('out-benchmark'),
      note: document.getElementById('out-note'),
    };

    function num(el, fallback) {
      var value = parseFloat(el && el.value);
      return isFinite(value) && value >= 0 ? value : fallback;
    }

    var dollars = function (n) {
      return '$' + Math.round(n).toLocaleString('en-US');
    };

    function recalc() {
      var overhead = num(inputs.overhead, 0);
      var income = num(inputs.income, 0);
      var profit = num(inputs.profit, 0);
      var hours = Math.max(num(inputs.hours, 40), 1);
      var weeks = Math.min(Math.max(num(inputs.weeks, 48), 1), 52);
      var utilisation = Math.min(Math.max(num(inputs.utilisation, 60), 1), 100);

      var billable = hours * weeks * (utilisation / 100);
      var required = (overhead + income + profit) / billable;
      var breakeven = (overhead + income) / billable;
      var overheadPerHour = overhead / billable;

      out.rate.textContent = dollars(required);
      out.hours.textContent = Math.round(billable).toLocaleString('en-US');
      out.overhead.textContent = dollars(overheadPerHour);
      out.breakeven.textContent = dollars(breakeven);

      var slug = tradeSelect ? tradeSelect.value : '';
      var bench = benchmarks[slug];

      if (!bench) {
        out.benchmark.textContent = 'Pick a trade';
        out.note.textContent =
          'Choose your trade to compare this with typical published rates.';
        return;
      }

      out.benchmark.textContent = dollars(bench.rate) + '/hr';

      var gap = required - bench.rate;
      if (gap > 1) {
        out.note.textContent =
          'You need ' +
          dollars(gap) +
          ' an hour more than the ' +
          bench.name.toLowerCase() +
          ' typical rate. Your overhead may be high or your billable share low, or local rates may not support the income you entered.';
      } else if (gap < -1) {
        out.note.textContent =
          'You are ' +
          dollars(-gap) +
          ' an hour below the ' +
          bench.name.toLowerCase() +
          ' typical rate, so there may be room to take more profit than you entered.';
      } else {
        out.note.textContent =
          'You are within a dollar of the ' + bench.name.toLowerCase() + ' typical rate.';
      }
    }

    ids.forEach(function (id) {
      if (inputs[id]) inputs[id].addEventListener('input', recalc);
    });
    if (tradeSelect) {
      tradeSelect.addEventListener('change', function () {
        var bench = benchmarks[tradeSelect.value];
        // Prefill overhead from the benchmark so the trade choice does something
        // useful rather than only changing the comparison line.
        if (bench && inputs.overhead) {
          var hours = Math.max(num(inputs.hours, 45), 1);
          var weeks = Math.min(Math.max(num(inputs.weeks, 48), 1), 52);
          var utilisation = Math.min(Math.max(num(inputs.utilisation, 60), 1), 100);
          var billable = hours * weeks * (utilisation / 100);
          inputs.overhead.value = Math.round((bench.overheadPerHour * billable) / 500) * 500;
        }
        recalc();
      });
    }

    // Never submit: there is nowhere to submit to.
    form.addEventListener('submit', function (event) {
      event.preventDefault();
    });

    recalc();
  })();
</script>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerdictBox from '../../components/VerdictBox.astro';
import UpdatedMeta from '../../components/UpdatedMeta.astro';
import CompareTable from '../../components/CompareTable.astro';
import AffiliateLink from '../../components/AffiliateLink.astro';
import Disclosure from '../../components/Disclosure.astro';
import LogoMark from '../../components/LogoMark.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
import Sources from '../../components/Sources.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/Faq.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { score1, priceLabel } from '../../lib/format';
import { compareUrl, toolUrl, alternativesUrl } from '../../lib/urls';
import { article, breadcrumbs, faqPage } from '../../lib/schema';
import { comparisonLoser, type Tool, type Comparison } from '../../lib/content';

export async function getStaticPaths() {
  const comparisons = await getCollection('comparisons');
  const tools = await getCollection('tools');
  const byId = new Map(tools.map((t) => [t.id, t]));
  const alternatives = await getCollection('alternatives');
  const altSlugs = new Set(alternatives.map((a) => a.data.tool.id));

  return comparisons.map((comparison) => ({
    params: { slug: comparison.data.slug },
    props: {
      comparison,
      a: byId.get(comparison.data.toolA.id)!,
      b: byId.get(comparison.data.toolB.id)!,
      altSlugs: [...altSlugs],
    },
  }));
}

interface Props {
  comparison: Comparison;
  a: Tool;
  b: Tool;
  altSlugs: string[];
}

const { comparison, a, b, altSlugs } = Astro.props;
const c = comparison.data;
const { Content } = await render(comparison);

const loser = comparisonLoser(a, b);
const winner = loser.id === a.id ? b : a;
const loserHasAlternatives = altSlugs.includes(loser.id);
const year = c.updatedDate.getUTCFullYear();

const path = compareUrl(c.slug);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Compare', path: '/compare/' },
  { name: c.title, path },
];

const h1 = `${c.title} (${year}): which is better for your business?`;
const title = `${c.title} (${year}): Pricing, Features and Which to Choose`;
const description = `${c.title} compared for ${year}: ${c.rows.length} features side by side, pricing and who each one suits. ${c.verdict.split('. ')[0]}.`.slice(0, 300);

const sides = [
  { tool: a, points: c.pickAIf },
  { tool: b, points: c.pickBIf },
];

const faqItems = [
  { q: `Is ${a.data.name} or ${b.data.name} better?`, a: c.verdict },
  {
    q: `Which is cheaper, ${a.data.name} or ${b.data.name}?`,
    a: `${a.data.name}: ${priceLabel(a.data.priceFrom).toLowerCase()} (${a.data.pricingModel.toLowerCase()}). ${b.data.name}: ${priceLabel(
      b.data.priceFrom,
    ).toLowerCase()} (${b.data.pricingModel.toLowerCase()}). Card processing is charged separately by both.`,
  },
  {
    q: `Do ${a.data.name} and ${b.data.name} offer free trials?`,
    a: `${a.data.name}: ${a.data.freeTrial}. ${b.data.name}: ${b.data.freeTrial}.`,
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogImage={`/og/compare/${c.slug}.png`}
  ads
  modified={c.updatedDate}
  jsonLd={[
    breadcrumbs(crumbs),
    article({ title: h1, description, path, publishDate: c.updatedDate, updatedDate: c.updatedDate, image: `/og/compare/${c.slug}.png` }),
    faqPage(faqItems),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <article>
    <header class="wrap pt-6 sm:pt-8">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3">
          <LogoMark text={a.data.logoText} color={a.data.logoColor} size="md" />
          <span class="text-sm font-semibold uppercase tracking-wide text-ink-muted">vs</span>
          <LogoMark text={b.data.logoText} color={b.data.logoColor} size="md" />
        </div>
        <h1 class="mt-5 text-[2.1rem] leading-[1.1] sm:text-5xl">{h1}</h1>
        <UpdatedMeta updatedDate={c.updatedDate} class="mt-5" />
      </div>
    </header>

    <div class="wrap mt-8">
      <VerdictBox label="Short answer" class="max-w-4xl">
        <p>{c.verdict}</p>
      </VerdictBox>

      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {
          [a, b].map((tool) => (
            <div class:list={['card flex flex-col p-5 sm:p-6', tool.id === winner.id && 'ring-2 ring-brand/70']}>
              <div class="flex items-start gap-3">
                <LogoMark text={tool.data.logoText} color={tool.data.logoColor} size="sm" />
                <div class="min-w-0 flex-1">
                  {tool.id === winner.id && <span class="pill pill-brand mb-1">Higher rated</span>}
                  <a href={toolUrl(tool.data.slug)} class="block text-xl font-semibold leading-tight text-ink no-underline hover:text-brand">
                    {tool.data.name}
                  </a>
                  <p class="text-sm text-ink-muted">{priceLabel(tool.data.priceFrom)} · {tool.data.freeTrial}</p>
                </div>
                <ScoreBadge score={tool.data.score} />
              </div>
              <p class="mt-3 flex-1 text-[0.95rem] leading-snug text-ink-soft">{tool.data.bestFor}</p>
              <div class="mt-4 flex flex-col gap-2 sm:flex-row">
                <AffiliateLink slug={tool.data.slug} name={tool.data.name} placement="compare-header" />
                <a href={toolUrl(tool.data.slug)} class="btn btn-secondary">Full review</a>
              </div>
            </div>
          ))
        }
      </div>
      <Disclosure class="mt-4 max-w-3xl" />
    </div>

    <section class="wrap mt-14" aria-labelledby="pick-heading">
      <h2 id="pick-heading" class="section-title">Which one should you choose?</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {
          sides.map(({ tool, points }) => (
            <section class="card p-5 sm:p-6">
              <h3 class="flex items-center gap-2.5 font-sans text-lg font-semibold">
                <LogoMark text={tool.data.logoText} color={tool.data.logoColor} size="xs" />
                Choose {tool.data.name} if
              </h3>
              <ul class="mt-4 space-y-2.5">
                {points.map((point) => (
                  <li class="flex gap-2.5 leading-snug text-ink-soft">
                    <svg class="mt-0.5 h-4.5 w-4.5 flex-none text-brand" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8.5 6 12l7.5-8" /></svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-5">
                <AffiliateLink slug={tool.data.slug} name={tool.data.name} variant="plain" label={`Visit ${tool.data.name}`} placement="compare-pick" />
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <section class="wrap mt-14" aria-labelledby="table-heading">
      <h2 id="table-heading" class="section-title">{a.data.name} vs {b.data.name}: feature comparison</h2>
      <div class="mt-5">
        <CompareTable a={a.data} b={b.data} rows={c.rows} />
      </div>
    </section>

    <div class="wrap-narrow">
      <AdSlot />
      <div class="prose-shop mt-10">
        <Content />
      </div>
      <Faq items={faqItems} heading={`${c.title}: FAQ`} />
      <Sources sources={c.sources} />
    </div>

    <section class="wrap mt-14" aria-labelledby="next-heading">
      <h2 id="next-heading" class="section-title">Keep researching</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-3">
        {
          [a, b].map((tool) => (
            <li>
              <a href={toolUrl(tool.data.slug)} class="card card-link flex h-full items-center gap-3 p-4 no-underline">
                <LogoMark text={tool.data.logoText} color={tool.data.logoColor} size="sm" />
                <span class="flex-1">
                  <span class="block text-xs font-semibold uppercase tracking-wide text-ink-muted">Full review</span>
                  <span class="block font-semibold text-ink">{tool.data.name}</span>
                </span>
                <span class="text-sm font-bold tabular-nums text-ink">{score1(tool.data.score)}</span>
              </a>
            </li>
          ))
        }
        {
          loserHasAlternatives && (
            <li>
              <a href={alternativesUrl(loser.data.slug)} class="card card-link flex h-full flex-col justify-center p-4 no-underline">
                <span class="block text-xs font-semibold uppercase tracking-wide text-ink-muted">Not sold on {loser.data.name}?</span>
                <span class="block font-semibold text-ink">{loser.data.name} alternatives</span>
              </a>
            </li>
          )
        }
      </ul>
    </section>
  </article>

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

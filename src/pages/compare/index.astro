---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LogoMark from '../../components/LogoMark.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { compareUrl, alternativesUrl } from '../../lib/urls';
import { breadcrumbs, itemList, webPage } from '../../lib/schema';

const comparisons = await getCollection('comparisons');
const alternatives = await getCollection('alternatives');
const tools = await getCollection('tools');
const byId = new Map(tools.map((t) => [t.id, t]));

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Compare', path: '/compare/' },
];
const title = 'Software comparisons, head to head';
const description =
  'Side-by-side comparisons of the most popular field service, salon, fitness and auto repair software: pricing, features and which one to choose.';
---

<BaseLayout
  title={title}
  description={description}
  path="/compare/"
  jsonLd={[
    webPage({ path: '/compare/', title, description, type: 'CollectionPage' }),
    breadcrumbs(crumbs),
    itemList(title, comparisons.map((c) => ({ name: c.data.title, path: compareUrl(c.data.slug) }))),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <header class="wrap pt-6 sm:pt-8">
    <p class="kicker">Compare</p>
    <h1 class="mt-3 max-w-3xl text-[2.1rem] leading-[1.1] sm:text-5xl">{title}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{description}</p>
  </header>

  <section class="wrap mt-10">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        comparisons.map((c) => {
          const a = byId.get(c.data.toolA.id)!;
          const b = byId.get(c.data.toolB.id)!;
          return (
            <li>
              <a href={compareUrl(c.data.slug)} class="card card-link flex h-full flex-col p-5 no-underline">
                <span class="flex items-center gap-2">
                  <LogoMark text={a.data.logoText} color={a.data.logoColor} size="sm" />
                  <span class="text-xs font-semibold uppercase text-ink-muted">vs</span>
                  <LogoMark text={b.data.logoText} color={b.data.logoColor} size="sm" />
                </span>
                <h2 class="mt-4 text-xl text-ink">{c.data.title}</h2>
                <p class="mt-2 flex-1 text-[0.95rem] leading-snug text-ink-soft">{c.data.verdict.split('. ')[0]}.</p>
                <span class="mt-4 text-sm font-semibold text-brand">Compare <span aria-hidden="true">&rarr;</span></span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="wrap mt-14" aria-labelledby="alt-heading">
    <h2 id="alt-heading" class="section-title">Looking to switch?</h2>
    <p class="mt-2 text-ink-soft">The best alternatives to popular tools, with a plan for moving your data.</p>
    <ul class="mt-5 flex flex-wrap gap-2">
      {
        alternatives.map((alt) => {
          const t = byId.get(alt.data.tool.id)!;
          return (
            <li>
              <a href={alternativesUrl(t.data.slug)} class="card card-link flex items-center gap-2 !rounded-full py-1.5 pl-1.5 pr-4 text-sm font-medium text-ink no-underline">
                <LogoMark text={t.data.logoText} color={t.data.logoColor} size="xs" class="!rounded-full" />
                {t.data.name} alternatives
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

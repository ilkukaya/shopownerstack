---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerdictBox from '../../components/VerdictBox.astro';
import LogoMark from '../../components/LogoMark.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { compareUrl } from '../../lib/urls';
import { score1 } from '../../lib/format';
import { breadcrumbs } from '../../lib/schema';

const comparisons = await getCollection('comparisons');
const tools = await getCollection('tools');
const byId = new Map(tools.map((t) => [t.id, t]));

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Compare', path: '/compare/' },
];
---

<BaseLayout
  title="Software comparisons, head to head"
  description={`${comparisons.length} side-by-side comparisons of the software local service businesses actually shortlist, with a verdict on each and the feature rows that decide it.`}
  path="/compare/"
  jsonLd={[breadcrumbs(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <div class="wrap pt-8">
    <h1 class="font-condensed text-5xl font-bold uppercase leading-none sm:text-6xl">
      Head to head
    </h1>

    <VerdictBox class="mt-6" label="The short answer">
      <p>
        Most shortlists come down to two products, and the deciding row is almost never the one in
        the marketing. Each comparison below is scored row by row from the same tests, with the
        cell that wins each row highlighted.
      </p>
    </VerdictBox>
  </div>

  <section class="wrap mt-10" aria-label="All comparisons">
    <ul class="grid gap-5 md:grid-cols-2">
      {
        comparisons.map((c) => {
          const a = byId.get(c.data.toolA.id)!;
          const b = byId.get(c.data.toolB.id)!;
          return (
            <li>
              <a
                href={compareUrl(c.data.slug)}
                class="board flex h-full flex-col p-5 no-underline transition-colors hover:border-ink"
              >
                <span class="flex items-center gap-3">
                  <LogoMark text={a.data.logoText} color={a.data.logoColor} size="sm" />
                  <span class="font-condensed text-lg font-bold uppercase text-ink-muted">vs</span>
                  <LogoMark text={b.data.logoText} color={b.data.logoColor} size="sm" />
                  <span class="ml-auto text-sm font-semibold tabular-nums text-ink-muted">
                    {score1(a.data.score)} / {score1(b.data.score)}
                  </span>
                </span>
                <h2 class="mt-3 font-condensed text-2xl font-bold uppercase leading-none">
                  {c.data.title}
                </h2>
                <p class="mt-2 flex-1 leading-snug text-ink-soft">{c.data.verdict}</p>
                <p class="mt-3 font-condensed text-sm font-bold uppercase tracking-[0.12em] text-ink-muted">
                  {c.data.rows.length} rows compared
                </p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

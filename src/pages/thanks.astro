---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CALCULATOR_URL } from '../lib/urls';
import { breadcrumbs } from '../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Thanks', path: '/thanks/' },
];
---

<BaseLayout
  title="Thanks"
  description="Your message reached us."
  path="/thanks/"
  noindex
  jsonLd={[breadcrumbs(crumbs)]}
>
  <div class="wrap-narrow py-20 text-center">
    <span
      class="mx-auto flex h-16 w-16 items-center justify-center bg-yellow text-ink"
      aria-hidden="true"
    >
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 12.5 9.5 18 20 6"></path>
      </svg>
    </span>

    <h1 class="mt-6 font-condensed text-5xl font-bold uppercase leading-none sm:text-6xl">
      That is with us
    </h1>

    <p class="mt-5 text-lg leading-relaxed text-ink-soft">
      If you asked for a demo, the vendor will be in touch directly - usually within a working
      day. If you subscribed, the first email arrives the next time a score moves, not before.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/reviews/" class="btn btn-primary">Back to the reviews</a>
      <a href={CALCULATOR_URL} class="btn btn-ghost">Job pricing calculator</a>
    </div>
  </div>
</BaseLayout>

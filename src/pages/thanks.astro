---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank you" description="Your submission was received." path="/thanks/" noindex>
  <div class="wrap-narrow py-16 text-center sm:py-24">
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-wash text-brand" aria-hidden="true">
      <svg class="h-7 w-7" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 8.5 6.5 12 13 4.5" /></svg>
    </span>
    <h1 class="mt-6 text-4xl sm:text-5xl">Thanks, got it.</h1>
    <p class="mt-4 text-lg text-ink-soft">
      Your message is in. If you subscribed, the next monthly briefing will reach your inbox. If you
      wrote to us, we will reply by email.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/best/" class="btn btn-primary">Find software for my trade</a>
      <a href="/" class="btn btn-secondary">Back to home</a>
    </div>
  </div>
</BaseLayout>

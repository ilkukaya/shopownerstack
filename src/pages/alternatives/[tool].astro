---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerdictBox from '../../components/VerdictBox.astro';
import UpdatedMeta from '../../components/UpdatedMeta.astro';
import RankedTool from '../../components/RankedTool.astro';
import Disclosure from '../../components/Disclosure.astro';
import LogoMark from '../../components/LogoMark.astro';
import Sources from '../../components/Sources.astro';
import AdSlot from '../../components/AdSlot.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { alternativesUrl, toolUrl, compareUrl } from '../../lib/urls';
import { score1 } from '../../lib/format';
import { breadcrumbs, howTo, itemList, article } from '../../lib/schema';
import { comparisonFor, type Tool, type Alternative } from '../../lib/content';

export async function getStaticPaths() {
  const alternatives = await getCollection('alternatives');
  const tools = await getCollection('tools');
  const byId = new Map(tools.map((t) => [t.id, t]));

  return alternatives.map((entry) => ({
    params: { tool: byId.get(entry.data.tool.id)!.data.slug },
    props: {
      entry,
      tool: byId.get(entry.data.tool.id)!,
      options: entry.data.alternatives.map((ref) => byId.get(ref.id)!),
    },
  }));
}

interface Props {
  entry: Alternative;
  tool: Tool;
  options: Tool[];
}

const { entry, tool, options } = Astro.props;
const a = entry.data;
const { Content } = await render(entry);

const comparisons = await getCollection('comparisons');
const comparison = comparisonFor(tool, comparisons);

const year = a.updatedDate.getUTCFullYear();
const path = alternativesUrl(tool.data.slug);
const name = tool.data.name;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reviews', path: '/reviews/' },
  { name, path: toolUrl(tool.data.slug) },
  { name: 'Alternatives', path },
];

const h1 = `${options.length} best ${name} alternatives in ${year}`;
const title = `${options.length} Best ${name} Alternatives (${year}), Ranked`;
const description = `The best ${name} alternatives for ${year}: ${options
  .map((o) => o.data.name)
  .join(', ')}. Why owners switch, what to use instead, and a step-by-step plan to move your data.`.slice(0, 300);

const migrationName = `How to switch from ${name}`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogImage={`/og/alternatives/${tool.data.slug}.png`}
  ads
  modified={a.updatedDate}
  jsonLd={[
    breadcrumbs(crumbs),
    article({ title: h1, description, path, publishDate: a.updatedDate, updatedDate: a.updatedDate, image: `/og/alternatives/${tool.data.slug}.png` }),
    itemList(h1, options.map((o) => ({ name: o.data.name, path: toolUrl(o.data.slug) }))),
    howTo(migrationName, a.migrationSteps),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <article>
    <header class="wrap pt-6 sm:pt-8">
      <div class="max-w-3xl">
        <LogoMark text={tool.data.logoText} color={tool.data.logoColor} size="lg" />
        <h1 class="mt-5 text-[2.1rem] leading-[1.1] sm:text-5xl">{h1}</h1>
        <UpdatedMeta updatedDate={a.updatedDate} class="mt-5" />
      </div>
    </header>

    <div class="wrap mt-8">
      <VerdictBox label="Short answer" class="max-w-4xl">
        <p>{a.verdict}</p>
      </VerdictBox>
      <Disclosure class="mt-4 max-w-3xl" />

      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Alternatives on this page">
        {options.map((o, i) => (
          <li>
            <a href={`#pick-${o.data.slug}`} class="pill !py-1.5 no-underline hover:bg-brand-wash hover:text-brand-deep">
              {i + 1}. {o.data.name} <span class="text-ink-muted">{score1(o.data.score)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <section class="wrap mt-14" aria-labelledby="why-heading">
      <h2 id="why-heading" class="section-title">Why do businesses switch from {name}?</h2>
      <p class="mt-2 max-w-3xl text-ink-soft">The complaints that come up most often in public user reviews:</p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {
          a.whyPeopleLeave.map((reason) => (
            <li class="card flex gap-3 p-4 leading-snug text-ink-soft">
              <span class="mt-1 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-bad-wash text-bad" aria-hidden="true">
                <svg class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M8 4v5M8 12h.01" /></svg>
              </span>
              {reason}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 max-w-3xl text-ink-soft">
        None of that makes {name} a bad product: we rate it {score1(tool.data.score)} out of 10. Read the
        <a href={toolUrl(tool.data.slug)} class="font-medium text-brand underline underline-offset-2">{name} review</a>
        before deciding the software is the problem.
      </p>
    </section>

    <section class="wrap mt-14" aria-labelledby="options-heading">
      <h2 id="options-heading" class="section-title">What should you use instead of {name}?</h2>
      <p class="mt-2 max-w-3xl text-ink-soft">
        Ordered by how well each one fixes the reasons above, not by raw rating. The right replacement
        depends on which problem is yours.
      </p>
      <ol class="mt-6 space-y-5">
        {options.map((option, i) => <li><RankedTool rank={i + 1} tool={option.data} /></li>)}
      </ol>
    </section>

    <div class="wrap"><AdSlot /></div>

    <section class="wrap mt-4" aria-labelledby="migration-heading">
      <h2 id="migration-heading" class="section-title">{migrationName}</h2>
      <p class="mt-2 max-w-3xl text-ink-soft">
        In this order. The expensive mistakes in a migration are usually things left behind, not things
        imported wrongly.
      </p>
      <ol class="mt-6 grid gap-3 md:grid-cols-2">
        {
          a.migrationSteps.map((step, i) => (
            <li class="card flex gap-4 p-5">
              <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-brand text-sm font-bold text-white" aria-hidden="true">
                {i + 1}
              </span>
              <div class="min-w-0">
                <h3 class="font-sans text-base font-semibold leading-snug">{step.name}</h3>
                <p class="mt-1 text-[0.95rem] leading-relaxed text-ink-soft">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-sm text-ink-muted">
        The general version of this plan is in our guide:
        <a href="/guides/how-to-switch-field-service-software/" class="font-medium text-brand underline underline-offset-2">how to switch field service software</a>.
      </p>
    </section>

    <div class="wrap-narrow">
      <div class="prose-shop mt-14">
        <Content />
      </div>
      <Sources sources={a.sources} />
    </div>

    <section class="wrap mt-14" aria-labelledby="next-heading">
      <h2 id="next-heading" class="section-title">Keep researching</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-3">
        {
          [
            { href: toolUrl(tool.data.slug), kicker: 'Full review', text: `${name} review` },
            comparison && { href: compareUrl(comparison.data.slug), kicker: 'Head to head', text: comparison.data.title },
            { href: '/guides/how-to-switch-field-service-software/', kicker: 'Guide', text: 'Switching software without losing money' },
          ]
            .filter(Boolean)
            .map((l) => (
              <li>
                <a href={l!.href} class="card card-link flex h-full items-center justify-between gap-3 p-4 no-underline">
                  <span>
                    <span class="block text-xs font-semibold uppercase tracking-wide text-ink-muted">{l!.kicker}</span>
                    <span class="mt-0.5 block font-semibold text-ink">{l!.text}</span>
                  </span>
                  <span class="text-brand" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
        }
      </ul>
    </section>
  </article>

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

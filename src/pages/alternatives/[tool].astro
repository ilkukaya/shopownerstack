---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerdictBox from '../../components/VerdictBox.astro';
import TestDates from '../../components/TestDates.astro';
import RankedTool from '../../components/RankedTool.astro';
import Disclosure from '../../components/Disclosure.astro';
import LogoMark from '../../components/LogoMark.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { alternativesUrl, toolUrl, compareUrl } from '../../lib/urls';
import { score1 } from '../../lib/format';
import { breadcrumbs, howTo } from '../../lib/schema';
import { oldestTest, comparisonFor, type Tool, type Alternative } from '../../lib/content';

export async function getStaticPaths() {
  const alternatives = await getCollection('alternatives');
  const tools = await getCollection('tools');
  const byId = new Map(tools.map((t) => [t.id, t]));

  return alternatives.map((entry) => ({
    params: { tool: byId.get(entry.data.tool.id)!.data.slug },
    props: {
      entry,
      tool: byId.get(entry.data.tool.id)!,
      options: entry.data.alternatives.map((ref) => byId.get(ref.id)!),
    },
  }));
}

interface Props {
  entry: Alternative;
  tool: Tool;
  options: Tool[];
}

const { entry, tool, options } = Astro.props;
const a = entry.data;
const { Content } = await render(entry);

const comparisons = await getCollection('comparisons');
const comparison = comparisonFor(tool, comparisons);

const dates = oldestTest([tool, ...options]);
const path = alternativesUrl(tool.data.slug);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reviews', path: '/reviews/' },
  { name: tool.data.name, path: toolUrl(tool.data.slug) },
  { name: 'Alternatives', path },
];

const description = `${options.length} tested alternatives to ${tool.data.name}, ranked, with a step-by-step migration plan. ${tool.data.name} scored ${score1(tool.data.score)}/10 in our own testing.`;

const migrationName = `How to move off ${tool.data.name}`;
---

<BaseLayout
  title={a.title}
  description={description}
  path={path}
  ogType="article"
  jsonLd={[breadcrumbs(crumbs), howTo(migrationName, a.migrationSteps)]}
>
  <Breadcrumbs items={crumbs} />

  <article>
    <header class="wrap pt-8">
      <div class="flex flex-wrap items-center gap-4">
        <LogoMark text={tool.data.logoText} color={tool.data.logoColor} size="lg" />
        <h1 class="font-condensed text-5xl font-bold uppercase leading-none sm:text-6xl">
          {a.title}
        </h1>
      </div>

      <!-- Verdict is the first paragraph after the H1. -->
      <VerdictBox class="mt-6">
        <p>{a.verdict}</p>
      </VerdictBox>

      <TestDates testDate={dates.testDate} nextRetest={dates.nextRetest} class="mt-5" />
      <Disclosure class="mt-4 max-w-3xl" />
    </header>

    <!-- Why people leave -->
    <section class="wrap mt-14" aria-labelledby="why-heading">
      <h2 id="why-heading" class="font-condensed text-3xl font-bold uppercase sm:text-4xl">
        Why do shops leave {tool.data.name}?
      </h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {
          a.whyPeopleLeave.map((reason) => (
            <li class="board border-l-4 border-l-bad p-4 leading-snug">{reason}</li>
          ))
        }
      </ul>
      <p class="mt-4 text-ink-soft">
        None of that makes it a bad product - it scored {score1(tool.data.score)} out of 10 in our
        testing. Read the
        <a
          href={toolUrl(tool.data.slug)}
          class="underline decoration-yellow decoration-[3px] underline-offset-2"
          >{tool.data.name} review</a
        >
        before you decide the problem is the software.
      </p>
    </section>

    <!-- Ranked alternatives -->
    <section class="wrap mt-14" aria-labelledby="options-heading">
      <h2 id="options-heading" class="font-condensed text-3xl font-bold uppercase sm:text-4xl">
        What should you use instead?
      </h2>
      <p class="mt-2 max-w-3xl text-ink-soft">
        Ranked in the order we would consider them for someone leaving {tool.data.name}, not by raw
        score. The best replacement depends on which of the reasons above is yours.
      </p>
      <ol class="mt-6 space-y-6">
        {options.map((option, i) => <li><RankedTool rank={i + 1} tool={option.data} /></li>)}
      </ol>
    </section>

    <!-- Migration steps -->
    <section class="wrap mt-14" aria-labelledby="migration-heading">
      <h2 id="migration-heading" class="font-condensed text-3xl font-bold uppercase sm:text-4xl">
        {migrationName}
      </h2>
      <p class="mt-2 max-w-3xl text-ink-soft">
        In this order. The expensive mistakes in a migration are almost always things left behind
        rather than things imported wrongly.
      </p>
      <ol class="mt-6 space-y-4">
        {
          a.migrationSteps.map((step, i) => (
            <li class="board flex gap-4 p-5">
              <span
                class="flex h-9 w-9 flex-none items-center justify-center bg-yellow font-condensed text-lg font-bold leading-none text-ink"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <div class="min-w-0">
                <h3 class="font-condensed text-xl font-bold uppercase leading-tight">{step.name}</h3>
                <p class="mt-1.5 leading-relaxed text-ink-soft">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-sm text-ink-muted">
        The general version of this plan, including the four things that go wrong in most
        migrations, is in
        <a
          href="/guides/how-to-switch-field-service-software/"
          class="underline decoration-yellow decoration-[3px] underline-offset-2"
          >how to switch field service software</a
        >.
      </p>
    </section>

    <div class="wrap-narrow prose-shop mt-14">
      <Content />
    </div>

    <section class="wrap mt-14" aria-labelledby="next-heading">
      <h2 id="next-heading" class="font-condensed text-3xl font-bold uppercase sm:text-4xl">
        Read further
      </h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-3">
        <li>
          <a href={toolUrl(tool.data.slug)} class="board flex h-full flex-col p-4 no-underline hover:border-ink">
            <span class="font-condensed text-sm font-bold uppercase tracking-[0.14em] text-ink-muted">
              Full review
            </span>
            <span class="mt-1 font-condensed text-xl font-bold uppercase">{tool.data.name}</span>
          </a>
        </li>
        {
          comparison && (
            <li>
              <a
                href={compareUrl(comparison.data.slug)}
                class="board flex h-full flex-col p-4 no-underline hover:border-ink"
              >
                <span class="font-condensed text-sm font-bold uppercase tracking-[0.14em] text-ink-muted">
                  Head to head
                </span>
                <span class="mt-1 font-condensed text-xl font-bold uppercase">
                  {comparison.data.title}
                </span>
              </a>
            </li>
          )
        }
        <li>
          <a
            href="/guides/how-to-switch-field-service-software/"
            class="board flex h-full flex-col p-4 no-underline hover:border-ink"
          >
            <span class="font-condensed text-sm font-bold uppercase tracking-[0.14em] text-ink-muted">
              Guide
            </span>
            <span class="mt-1 font-condensed text-xl font-bold uppercase">
              Switching without losing money
            </span>
          </a>
        </li>
      </ul>
    </section>
  </article>

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TradeBoard from '../../components/TradeBoard.astro';
import LogoMark from '../../components/LogoMark.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { CATEGORY_META } from '../../lib/site';
import { bestUrl, toolUrl } from '../../lib/urls';
import { score1 } from '../../lib/format';
import { toolsInCategory } from '../../lib/content';
import { breadcrumbs, itemList, webPage } from '../../lib/schema';

const trades = await getCollection('trades');
const tools = await getCollection('tools');

const rows = trades.map((trade) => {
  const ranked = toolsInCategory(tools, trade.data.category);
  return { trade, ranked, winner: ranked[0] };
});

const toolCounts = Object.fromEntries(rows.map((r) => [r.trade.data.slug, r.ranked.length]));

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Best software', path: '/best/' },
];
const title = 'Best software for every type of service business';
const description = `Ranked software lists for ${trades.length} trades, from plumbers and HVAC contractors to salons, fitness studios and auto repair shops. Pick your trade and filter by team size.`;
---

<BaseLayout
  title={title}
  description={description}
  path="/best/"
  jsonLd={[
    webPage({ path: '/best/', title, description, type: 'CollectionPage' }),
    breadcrumbs(crumbs),
    itemList(
      title,
      rows.map((r) => ({
        name: `Best ${CATEGORY_META[r.trade.data.category].label.toLowerCase()} for ${r.trade.data.name.toLowerCase()}`,
        path: bestUrl(r.trade.data.category, r.trade.data.slug),
      })),
    ),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <header class="wrap pt-6 sm:pt-8">
    <p class="kicker">Best software</p>
    <h1 class="mt-3 max-w-3xl text-[2.1rem] leading-[1.1] sm:text-5xl">What kind of business do you run?</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{description}</p>
  </header>

  <section class="wrap mt-10">
    <TradeBoard trades={trades.map((t) => t.data)} toolCounts={toolCounts} />
  </section>

  <section class="wrap mt-14" aria-labelledby="winners-heading">
    <h2 id="winners-heading" class="section-title">Top pick for each trade</h2>
    <div class="table-scroll card mt-5">
      <table class="data-table min-w-[36rem]">
        <thead>
          <tr>
            <th scope="col">Trade</th>
            <th scope="col">Top pick</th>
            <th scope="col">Rating</th>
            <th scope="col">Tools compared</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map(({ trade, ranked, winner }) => (
              <tr>
                <th scope="row">
                  <a href={bestUrl(trade.data.category, trade.data.slug)} class="font-semibold text-ink underline decoration-line-strong underline-offset-2 hover:text-brand">
                    {trade.data.name}
                  </a>
                </th>
                <td>
                  <a href={toolUrl(winner.data.slug)} class="flex items-center gap-2 font-medium text-ink no-underline hover:text-brand">
                    <LogoMark text={winner.data.logoText} color={winner.data.logoColor} size="xs" />
                    {winner.data.name}
                  </a>
                </td>
                <td class="font-bold tabular-nums">{score1(winner.data.score)}</td>
                <td class="text-ink-soft">{ranked.length}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

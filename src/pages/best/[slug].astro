---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerdictBox from '../../components/VerdictBox.astro';
import UpdatedMeta from '../../components/UpdatedMeta.astro';
import RankedTool from '../../components/RankedTool.astro';
import LogoMark from '../../components/LogoMark.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
import Faq from '../../components/Faq.astro';
import Disclosure from '../../components/Disclosure.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import TradeIcon from '../../components/TradeIcon.astro';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateLink from '../../components/AffiliateLink.astro';
import { CATEGORY_META, TEAM_SIZES, TEAM_SIZE_LABELS } from '../../lib/site';
import { bestSlug, bestUrl, toolUrl, CALCULATOR_URL } from '../../lib/urls';
import { money, score1, priceLabel } from '../../lib/format';
import { breadcrumbs, faqPage, itemList, webPage } from '../../lib/schema';
import { toolsInCategory, oldestUpdate, type Tool, type Trade } from '../../lib/content';

export async function getStaticPaths() {
  const trades = await getCollection('trades');
  const tools = await getCollection('tools');

  return trades.map((trade) => {
    const ranked = toolsInCategory(tools, trade.data.category);
    return {
      params: { slug: bestSlug(trade.data.category, trade.data.slug) },
      props: { trade, ranked },
    };
  });
}

interface Props {
  trade: Trade;
  ranked: Tool[];
}

const { trade, ranked } = Astro.props;
const category = CATEGORY_META[trade.data.category];
const tradeName = trade.data.name.toLowerCase();
const categoryLower = category.label.toLowerCase();

const winner = ranked[0];
const dates = oldestUpdate(ranked);
const year = dates.updatedDate.getUTCFullYear();

const h1 = `Best ${categoryLower} for ${tradeName} in ${year}`;
const path = bestUrl(trade.data.category, trade.data.slug);

const priced = ranked.filter((t) => t.data.priceFrom !== null);
const cheapest = [...priced].sort((a, b) => a.data.priceFrom! - b.data.priceFrom!)[0];
const soloPick = ranked.find((t) => t.data.teamSizes.includes('solo'));
const biggestPick = ranked.find((t) => t.data.teamSizes.includes('16+'));

// Awards are derived from the data so they can never contradict the list.
const awards = new Map<string, string>();
awards.set(winner.id, 'Best overall');
if (cheapest && !awards.has(cheapest.id)) awards.set(cheapest.id, 'Best budget pick');
if (soloPick && !awards.has(soloPick.id)) awards.set(soloPick.id, 'Best for solo operators');
if (biggestPick && !awards.has(biggestPick.id)) awards.set(biggestPick.id, 'Best for larger teams');

const lc = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);

// The verdict is assembled from the rated data rather than written per page,
// so it can never drift away from the ratings below it.
const verdict = `${winner.data.name} is our top pick for ${tradeName}, rated ${score1(
  winner.data.score,
)}/10 (${lc(priceLabel(winner.data.priceFrom))}). ${
  ranked.length > 1
    ? `Choose ${ranked[1].data.name} instead if ${lc(ranked[1].data.getItIf[0])}.`
    : ''
}`;

const faqItems = [
  {
    q: `What is the best ${categoryLower} for ${tradeName}?`,
    a: `${winner.data.name} is our top pick, rated ${score1(winner.data.score)} out of 10. It suits ${lc(winner.data.bestFor)}. ${
      ranked.length > 1 ? `${ranked[1].data.name} is the strongest alternative.` : ''
    }`.trim(),
  },
  ...(priced.length > 0
    ? [
        {
          q: `How much does ${categoryLower} cost for ${tradeName}?`,
          a: `Across the ${ranked.length} tools on this list, published entry pricing runs from ${money(
            cheapest.data.priceFrom!,
          )} to ${money(Math.max(...priced.map((t) => t.data.priceFrom!)))} a month on annual billing${
            priced.length < ranked.length ? ', and some vendors only quote after a demo' : ''
          }. Card processing is charged separately, and per-user plans cost more than the headline price once you add office staff.`,
        },
      ]
    : []),
  ...(soloPick
    ? [
        {
          q: `What should a one-person ${tradeName.replace(/s$/, '')} business use?`,
          a: `${soloPick.data.name} is the highest-rated option on this list that supports a solo operator (${lc(
            priceLabel(soloPick.data.priceFrom),
          )}). ${soloPick.data.getItIf[0]}.`,
        },
      ]
    : []),
  ...(biggestPick
    ? [
        {
          q: `What works for a team of 16 or more?`,
          a: `${biggestPick.data.name} is the highest-rated option here that handles that headcount. At that size the pricing model (per user, per block of users, or quote) usually matters more than the feature list.`,
        },
      ]
    : []),
  {
    q: `How was this list put together?`,
    a: `We rate each tool against a published six-part rubric using vendor documentation, published pricing and patterns in public user reviews, then rank by overall rating. Partner commissions never affect the order. See our methodology page for details.`,
  },
];

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Best software', path: '/best/' },
  { name: `For ${tradeName}`, path },
];

const title = `${ranked.length} Best ${category.label} for ${trade.data.name} (${year})`;
const description = `Compare the ${ranked.length} best ${categoryLower} for ${tradeName} in ${year}. ${winner.data.name} is our top pick (${score1(
  winner.data.score,
)}/10). Pricing, free trials and who each tool suits, filterable by team size.`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogImage={`/og/best/${bestSlug(trade.data.category, trade.data.slug)}.png`}
  ads
  modified={dates.updatedDate}
  jsonLd={[
    webPage({ path, title: h1, description, dateModified: dates.updatedDate, type: 'CollectionPage' }),
    breadcrumbs(crumbs),
    itemList(h1, ranked.map((t) => ({ name: t.data.name, path: toolUrl(t.data.slug) }))),
    faqPage(faqItems),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <header class="wrap pt-6 sm:pt-8">
    <div class="max-w-3xl">
      <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-wash text-brand">
        <TradeIcon name={trade.data.icon} class="h-7 w-7" />
      </span>
      <h1 class="mt-4 text-[2.1rem] leading-[1.1] sm:text-5xl">{h1}</h1>
      <p class="mt-3 text-lg leading-relaxed text-ink-soft">{trade.data.description}</p>
      <UpdatedMeta updatedDate={dates.updatedDate} pricesChecked={dates.pricesChecked} class="mt-5" />
    </div>
  </header>

  <div class="wrap mt-8">
    <VerdictBox label="Quick answer" class="max-w-4xl">
      <p>{verdict}</p>
    </VerdictBox>
    <Disclosure class="mt-4 max-w-3xl" />
  </div>

  <!-- Quick comparison: the whole list on one screen before the detail. -->
  <section class="wrap mt-10" aria-labelledby="summary-heading">
    <h2 id="summary-heading" class="section-title">Our picks at a glance</h2>
    <div class="table-scroll card mt-5">
      <table class="data-table min-w-[40rem]">
        <caption class="sr-only">Ratings and entry pricing for {categoryLower} for {tradeName}</caption>
        <thead>
          <tr>
            <th scope="col">Software</th>
            <th scope="col">Best for</th>
            <th scope="col">Price</th>
            <th scope="col">Rating</th>
            <th scope="col"><span class="sr-only">Link</span></th>
          </tr>
        </thead>
        <tbody>
          {
            ranked.map((tool) => (
              <tr>
                <th scope="row">
                  <a href={`#pick-${tool.data.slug}`} class="flex items-center gap-3 no-underline">
                    <LogoMark text={tool.data.logoText} color={tool.data.logoColor} size="xs" />
                    <span>
                      <span class="block font-semibold text-ink hover:text-brand">{tool.data.name}</span>
                      {awards.has(tool.id) && <span class="block text-xs font-medium text-brand">{awards.get(tool.id)}</span>}
                    </span>
                  </a>
                </th>
                <td class="max-w-xs text-sm leading-snug text-ink-soft">{tool.data.bestFor}</td>
                <td class="whitespace-nowrap text-sm font-medium text-ink">{priceLabel(tool.data.priceFrom)}</td>
                <td class="font-bold tabular-nums text-ink">{score1(tool.data.score)}</td>
                <td>
                  <AffiliateLink slug={tool.data.slug} name={tool.data.name} variant="plain" label="Visit" placement="summary-table" class="text-sm" />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- Size filter -->
  <section class="wrap mt-12" aria-labelledby="filter-heading">
    <h2 id="filter-heading" class="section-title">The detailed reviews</h2>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0" role="group" aria-label="Filter by team size">
        <button type="button" class="size-filter pill !px-4 !py-2 !text-sm aria-pressed:!bg-night aria-pressed:!text-white" data-size="all" aria-pressed="true">All sizes</button>
        {
          TEAM_SIZES.map((size) => (
            <button type="button" class="size-filter pill whitespace-nowrap !px-4 !py-2 !text-sm aria-pressed:!bg-night aria-pressed:!text-white" data-size={size} aria-pressed="false">
              {TEAM_SIZE_LABELS[size]}
            </button>
          ))
        }
      </div>
      <p class="text-sm text-ink-muted" data-filter-status role="status">Showing all {ranked.length} tools.</p>
    </div>
  </section>

  <section class="wrap mt-6" aria-label={`Ranked ${categoryLower} for ${tradeName}`}>
    <ol class="space-y-5" data-tool-list>
      {ranked.map((tool, i) => <li><RankedTool rank={i + 1} tool={tool.data} award={awards.get(tool.id)} /></li>)}
    </ol>
    <p class="mt-6 hidden text-center text-ink-muted" data-empty-state>
      None of the tools on this list fit that team size yet. Clear the filter to see all of them.
    </p>
  </section>

  <div class="wrap"><AdSlot /></div>

  <section class="wrap mt-4">
    <div class="card flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <div>
        <h2 class="text-2xl">Before you choose on price</h2>
        <p class="mt-2 max-w-xl text-ink-soft">
          Work out what an hour of your time is worth. Saving $60 a month on software is not a saving
          if the cheaper tool adds an hour of admin every week.
        </p>
      </div>
      <a href={CALCULATOR_URL} class="btn btn-secondary">Open the rate calculator</a>
    </div>
  </section>

  <div class="wrap">
    <Faq items={faqItems} heading={`${category.label} for ${tradeName}: FAQ`} />
  </div>

  <section class="wrap mt-14">
    <h2 class="section-title">Full reviews on this list</h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        ranked.map((tool) => (
          <li>
            <a href={toolUrl(tool.data.slug)} class="card card-link flex items-center gap-3 p-4 no-underline">
              <LogoMark text={tool.data.logoText} color={tool.data.logoColor} size="sm" />
              <span class="flex-1 font-semibold text-ink">{tool.data.name} review</span>
              <ScoreBadge score={tool.data.score} />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

<script is:inline>
  // Team size filter. Toggles `hidden` on already-rendered cards, so the page
  // works with JavaScript disabled and simply shows everything.
  (function () {
    var buttons = Array.prototype.slice.call(document.querySelectorAll('.size-filter'));
    var cards = Array.prototype.slice.call(document.querySelectorAll('[data-tool-card]'));
    var status = document.querySelector('[data-filter-status]');
    var empty = document.querySelector('[data-empty-state]');
    if (!buttons.length || !cards.length) return;

    function apply(size) {
      var shown = 0;
      cards.forEach(function (card) {
        var sizes = (card.getAttribute('data-sizes') || '').split(' ');
        var match = size === 'all' || sizes.indexOf(size) !== -1;
        (card.parentElement || card).hidden = !match;
        if (match) shown += 1;
      });
      buttons.forEach(function (button) {
        button.setAttribute('aria-pressed', String(button.getAttribute('data-size') === size));
      });
      if (status) {
        status.textContent =
          size === 'all'
            ? 'Showing all ' + shown + ' tools.'
            : 'Showing ' + shown + ' of ' + cards.length + ' tools for that team size.';
      }
      if (empty) empty.classList.toggle('hidden', shown !== 0);
    }

    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        apply(button.getAttribute('data-size') || 'all');
      });
    });
  })();
</script>

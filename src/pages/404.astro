---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SEARCH_URL } from '../lib/urls';
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist." path="/404/" noindex>
  <div class="wrap-narrow py-16 text-center sm:py-24">
    <p class="kicker">Error 404</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">We couldn't find that page</h1>
    <p class="mt-4 text-lg text-ink-soft">It may have moved when we updated the site. Try a search, or start from one of these.</p>
    <form action={SEARCH_URL} method="get" class="mx-auto mt-8 flex max-w-md gap-2" role="search">
      <label for="nf-q" class="sr-only">Search</label>
      <input id="nf-q" name="q" type="search" placeholder="Search reviews and guides" class="min-h-12 min-w-0 flex-1 rounded-[10px] border border-line-strong bg-white px-4" />
      <button class="btn btn-primary">Search</button>
    </form>
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      <a href="/best/" class="pill !py-2 !px-4 no-underline">Best software</a>
      <a href="/reviews/" class="pill !py-2 !px-4 no-underline">Reviews</a>
      <a href="/compare/" class="pill !py-2 !px-4 no-underline">Comparisons</a>
      <a href="/guides/" class="pill !py-2 !px-4 no-underline">Guides</a>
    </div>
  </div>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import VerdictBox from '../components/VerdictBox.astro';
import { SITE } from '../lib/site';
import { breadcrumbs } from '../lib/schema';

const tools = (await getCollection('tools')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const networkLabels: Record<string, string> = {
  partnerstack: 'PartnerStack',
  impact: 'Impact',
  cj: 'CJ Affiliate',
  direct: 'Direct with the vendor',
  none: 'No programme',
};

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Affiliate disclosure', path: '/affiliate-disclosure/' },
];
---

<BaseLayout
  title="Affiliate disclosure"
  description="How ShopOwnerStack makes money, which products we have a partner relationship with, and the rules that stop it affecting a score."
  path="/affiliate-disclosure/"
  jsonLd={[breadcrumbs(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <div class="wrap pt-8">
    <h1 class="font-condensed text-5xl font-bold uppercase leading-none sm:text-6xl">
      Affiliate disclosure
    </h1>

    <VerdictBox class="mt-6" label="The short answer">
      <p>
        Some links on this site are partner links. If you book a demo or start a trial through one
        we may earn a commission, at no extra cost to you. Commission rates are not visible to
        whoever writes a review and are never an input to a score or a ranking.
      </p>
    </VerdictBox>
  </div>

  <div class="wrap-narrow prose-shop mt-12">
    <h2>What is a partner link?</h2>

    <p>
      A link that tells the vendor we sent you. If you go on to book a demo, start a trial or
      subscribe, they may pay us a commission. You pay the same price you would pay going direct.
    </p>

    <p>
      On this site every outbound link to a vendor goes through a <code>/go/</code> address, is
      marked <code>rel="sponsored nofollow"</code>, and opens in a new tab. That is true whether or
      not there is a commission attached, so you never have to guess which links earn us money -
      assume all of them might.
    </p>

    <h2>What it does not affect</h2>

    <ul>
      <li>
        <strong>Scores.</strong> A score comes from the rubric on
        <a href="/how-we-test/">how we test</a>, applied to a product we bought and used. There is
        no commission input.
      </li>
      <li>
        <strong>Rankings.</strong> Ranked lists are ordered by score for the trade in question.
        We do not move a product up because it pays better.
      </li>
      <li>
        <strong>Coverage.</strong> We review products with no partner programme, and we recommend
        against products we do earn from when the testing says so.
      </li>
      <li>
        <strong>What we say.</strong> No vendor reads a review before it publishes, and no vendor
        can have a result removed.
      </li>
    </ul>

    <h2>Who we have a relationship with</h2>

    <p>
      The table below lists every product on the site and which network, if any, its programme
      runs on. It is generated from the same data as the reviews, so it cannot fall out of date
      separately from them.
    </p>
  </div>

  <div class="wrap mt-8">
    <div class="table-scroll board">
      <table class="w-full min-w-[34rem] border-collapse text-left">
        <caption class="sr-only">Partner network for every product reviewed on this site</caption>
        <thead>
          <tr class="bg-ink text-white">
            <th scope="col" class="px-4 py-3 font-condensed text-sm font-bold uppercase tracking-[0.1em]">Product</th>
            <th scope="col" class="px-4 py-3 font-condensed text-sm font-bold uppercase tracking-[0.1em]">Network</th>
            <th scope="col" class="px-4 py-3 font-condensed text-sm font-bold uppercase tracking-[0.1em]">Partner link active</th>
          </tr>
        </thead>
        <tbody>
          {
            tools.map((tool) => (
              <tr class="border-t border-line">
                <th scope="row" class="px-4 py-3">
                  <a
                    href={`/reviews/${tool.data.slug}/`}
                    class="font-condensed text-lg font-bold uppercase underline decoration-yellow decoration-[3px] underline-offset-2"
                  >
                    {tool.data.name}
                  </a>
                </th>
                <td class="px-4 py-3">{networkLabels[tool.data.partnerNetwork]}</td>
                <td class="px-4 py-3 font-semibold">
                  {tool.data.affiliateUrl ? 'Yes' : 'No - link goes direct to the vendor'}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="wrap-narrow prose-shop mt-12">
    <h2>What we do with your details</h2>

    <p>
      If you submit a demo request form on this site, the details you enter are passed to the
      vendor named on that form so they can contact you about a demo. We do not sell your details
      to anyone else, and we do not add you to a mailing list unless you separately ask for it.
    </p>

    <p>
      Full detail is on the <a href="/privacy/">privacy page</a>.
    </p>

    <h2>Questions</h2>

    <p>
      If anything here is unclear, or you think a recommendation looks influenced by a
      commission, ask us directly at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. We would
      rather answer than have you wondering.
    </p>
  </div>
</BaseLayout>

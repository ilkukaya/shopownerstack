---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolTeaser from '../../components/ToolTeaser.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { CATEGORY_META, CATEGORIES } from '../../lib/site';
import { allTools, oldestUpdate } from '../../lib/content';
import { toolUrl } from '../../lib/urls';
import { formatDate } from '../../lib/format';
import { breadcrumbs, itemList, webPage } from '../../lib/schema';

const tools = await allTools();
const dates = oldestUpdate(tools);
const groups = CATEGORIES.map((c) => ({
  category: c,
  tools: tools.filter((t) => t.data.categories[0] === c),
})).filter((g) => g.tools.length > 0);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reviews', path: '/reviews/' },
];
const title = 'Software reviews for service businesses';
const description = `Independent reviews of ${tools.length} tools for field service, salons, fitness studios and auto repair shops: pricing, pros and cons, and who each one suits.`;
---

<BaseLayout
  title={title}
  description={description}
  path="/reviews/"
  jsonLd={[
    webPage({ path: '/reviews/', title, description, type: 'CollectionPage' }),
    breadcrumbs(crumbs),
    itemList(title, tools.map((t) => ({ name: `${t.data.name} review`, path: toolUrl(t.data.slug) }))),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <header class="wrap pt-6 sm:pt-8">
    <p class="kicker">All reviews</p>
    <h1 class="mt-3 max-w-3xl text-[2.1rem] leading-[1.1] sm:text-5xl">{title}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
      {description} Every review lists its sources and the date prices were last checked (oldest on
      this page: {formatDate(dates.pricesChecked)}).
    </p>
  </header>

  {
    groups.map((g) => (
      <section class="wrap mt-12" aria-labelledby={`g-${g.category}`}>
        <h2 id={`g-${g.category}`} class="text-2xl">{CATEGORY_META[g.category].label}</h2>
        <p class="mt-1 text-ink-muted">{CATEGORY_META[g.category].blurb}</p>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.tools.map((tool) => <li><ToolTeaser tool={tool.data} /></li>)}
        </ul>
      </section>
    ))
  }

  <div class="mt-16">
    <NewsletterForm />
  </div>
</BaseLayout>

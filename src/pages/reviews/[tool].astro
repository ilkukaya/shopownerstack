---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerdictBox from '../../components/VerdictBox.astro';
import UpdatedMeta from '../../components/UpdatedMeta.astro';
import ScoreBars from '../../components/ScoreBars.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
import GetItSkipIt from '../../components/GetItSkipIt.astro';
import ProsCons from '../../components/ProsCons.astro';
import PricingTable from '../../components/PricingTable.astro';
import AffiliateLink from '../../components/AffiliateLink.astro';
import Disclosure from '../../components/Disclosure.astro';
import Faq from '../../components/Faq.astro';
import Sources from '../../components/Sources.astro';
import AdSlot from '../../components/AdSlot.astro';
import ToolTeaser from '../../components/ToolTeaser.astro';
import LogoMark from '../../components/LogoMark.astro';
import StickyCta from '../../components/StickyCta.astro';
import { CATEGORY_META, TEAM_SIZE_LABELS } from '../../lib/site';
import { score1, formatDate, priceLabel } from '../../lib/format';
import { compareUrl, bestUrl, alternativesUrl, toolUrl, CALCULATOR_URL } from '../../lib/urls';
import { breadcrumbs, productReview, faqPage, webPage } from '../../lib/schema';
import {
  allTools,
  relatedTools,
  comparisonFor,
  tradeFor,
  alternativesFor,
  type Tool,
} from '../../lib/content';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({ params: { tool: tool.data.slug }, props: { tool } }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const t = tool.data;
const { Content, headings } = await render(tool);

const tools = await allTools();
const trades = await getCollection('trades');
const comparisons = await getCollection('comparisons');
const alternativeEntries = await getCollection('alternatives');

const related = relatedTools(tool, tools, 3);
const comparison = comparisonFor(tool, comparisons);
const trade = tradeFor(tool, trades);
const alternativePage = alternativesFor(tool, alternativeEntries);

const year = t.updatedDate.getUTCFullYear();
const path = toolUrl(t.slug);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reviews', path: '/reviews/' },
  { name: `${t.name} review`, path },
];

const title = `${t.name} Review ${year}: Pricing, Pros, Cons and Who It's For`;
const description = `Our ${t.name} review for ${year}: rated ${score1(t.score)}/10. ${priceLabel(t.priceFrom)}, ${t.freeTrial.toLowerCase()}. ${t.bestFor}.`.slice(0, 300);

const facts = [
  { label: 'Our rating', value: `${score1(t.score)} / 10` },
  { label: 'Starting price', value: priceLabel(t.priceFrom) },
  { label: 'Pricing model', value: t.pricingModel },
  { label: 'Free trial', value: t.freeTrial },
  { label: 'Free plan', value: t.freePlan ? 'Yes' : 'No' },
  { label: 'Team size', value: t.teamSizes.map((s) => TEAM_SIZE_LABELS[s]).join(', ') },
  ...t.keyFacts.filter(
    (f) => !['starting price', 'free trial', 'pricing model', 'free plan'].includes(f.label.toLowerCase()),
  ),
];

const toc = [
  { id: 'at-a-glance', text: 'At a glance' },
  { id: 'ratings', text: 'Ratings breakdown' },
  { id: 'fit', text: `Is ${t.name} right for you?` },
  { id: 'pros-cons', text: 'Pros and cons' },
  { id: 'pricing', text: 'Pricing' },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text })),
  ...(t.faq.length ? [{ id: 'faq', text: 'FAQ' }] : []),
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogImage={`/og/reviews/${t.slug}.png`}
  ads
  modified={t.updatedDate}
  jsonLd={[
    webPage({ path, title, description, dateModified: t.updatedDate }),
    breadcrumbs(crumbs),
    productReview({
      name: t.name,
      slug: t.slug,
      website: t.website,
      priceFrom: t.priceFrom,
      score: t.score,
      verdict: t.verdict,
      updatedDate: t.updatedDate,
      pros: t.pros,
      cons: t.cons,
      categoryLabel: CATEGORY_META[t.categories[0]].label,
    }),
    ...(t.faq.length > 0 ? [faqPage(t.faq)] : []),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <article>
    <header class="wrap pt-6 sm:pt-8">
      <div class="max-w-3xl">
        <div class="flex items-center gap-4">
          <LogoMark text={t.logoText} color={t.logoColor} size="lg" />
          <div class="flex flex-wrap gap-2">
            {t.categories.map((c) => <span class="pill">{CATEGORY_META[c].label}</span>)}
          </div>
        </div>
        <h1 class="mt-5 text-[2.1rem] leading-[1.1] sm:text-5xl">{t.name} review {year}</h1>
        <p class="mt-3 text-lg leading-relaxed text-ink-soft">{t.bestFor}.</p>
        <UpdatedMeta updatedDate={t.updatedDate} pricesChecked={t.pricesChecked} class="mt-5" />
      </div>
    </header>

    <div class="wrap mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14">
      <div class="min-w-0">
        <!-- The verdict is the first content after the H1 on purpose: it is the
             direct, quotable answer for readers and answer engines alike. -->
        <VerdictBox score={t.score}>
          <p>{t.verdict}</p>
        </VerdictBox>

        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center lg:hidden">
          <AffiliateLink slug={t.slug} name={t.name} label={`Try ${t.name}`} placement="header-mobile" class="btn-lg" />
          <span class="text-sm text-ink-muted">{t.freeTrial}</span>
        </div>
        <Disclosure class="mt-4" />

        <section id="at-a-glance" class="mt-12 scroll-mt-24" aria-labelledby="glance-heading">
          <h2 id="glance-heading" class="section-title">{t.name} at a glance</h2>
          <dl class="card mt-5 divide-y divide-line">
            {
              facts.map((f) => (
                <div class="grid grid-cols-[9rem_1fr] gap-4 px-5 py-3 sm:grid-cols-[12rem_1fr]">
                  <dt class="text-sm text-ink-muted">{f.label}</dt>
                  <dd class="text-[0.975rem] font-medium text-ink">{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section id="ratings" class="mt-14 scroll-mt-24" aria-labelledby="scores-heading">
          <h2 id="scores-heading" class="section-title">How we rate {t.name}</h2>
          <p class="mt-2 text-ink-soft">
            Six criteria, each rated out of 10 using the rubric on
            <a href="/how-we-test/" class="font-medium text-brand underline underline-offset-2">how we review</a>.
            Ratings are editorial judgements built from vendor documentation, published pricing and
            patterns in public user reviews.
          </p>
          <div class="card mt-5 p-5 sm:p-6">
            <ScoreBars subscores={t.subscores} />
            <div class="mt-5 flex items-center justify-between border-t border-line pt-4">
              <span class="font-semibold text-ink">Overall rating</span>
              <ScoreBadge score={t.score} />
            </div>
          </div>
        </section>

        <section id="fit" class="mt-14 scroll-mt-24" aria-labelledby="fit-heading">
          <h2 id="fit-heading" class="section-title">Is {t.name} right for your business?</h2>
          <div class="mt-5">
            <GetItSkipIt getItIf={t.getItIf} skipItIf={t.skipItIf} name={t.name} />
          </div>
        </section>

        <section id="pros-cons" class="mt-14 scroll-mt-24" aria-labelledby="proscons-heading">
          <h2 id="proscons-heading" class="section-title">{t.name} pros and cons</h2>
          <div class="mt-5">
            <ProsCons pros={t.pros} cons={t.cons} />
          </div>
        </section>

        <section id="pricing" class="mt-14 scroll-mt-24" aria-labelledby="pricing-heading">
          <h2 id="pricing-heading" class="section-title">How much does {t.name} cost?</h2>
          <p class="mt-2 text-ink-soft" data-answer>
            {
              t.priceFrom === null
                ? `${t.name} does not publish list prices; you get a quote after a demo.`
                : `${t.name} starts at $${t.priceFrom} a month on annual billing.`
            }{' '}
            {t.pricingModel}. Prices checked {formatDate(t.pricesChecked)}; card processing fees are
            charged separately.
          </p>
          <div class="mt-5">
            <PricingTable name={t.name} pricing={t.pricing} />
          </div>
          <div class="mt-4">
            <AffiliateLink slug={t.slug} name={t.name} variant="plain" label={`Check current ${t.name} pricing`} placement="pricing" />
          </div>
        </section>

        <AdSlot />

        <div class="prose-shop mt-14">
          <Content />
        </div>

        <div class="card mt-12 flex flex-col items-start gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
          <div class="flex items-center gap-4">
            <LogoMark text={t.logoText} color={t.logoColor} size="md" />
            <div>
              <p class="font-semibold text-ink">Ready to try {t.name}?</p>
              <p class="text-sm text-ink-muted">{t.freeTrial}</p>
            </div>
          </div>
          <AffiliateLink slug={t.slug} name={t.name} label={`Try ${t.name}`} placement="post-review" />
        </div>

        <Faq items={t.faq} heading={`${t.name} FAQ`} />

        <Sources sources={t.sources} />

        <section class="mt-14" aria-labelledby="next-heading">
          <h2 id="next-heading" class="section-title">Compare {t.name} with other options</h2>

          <ul class="mt-5 grid gap-4 sm:grid-cols-3">
            {related.map((r) => <li><ToolTeaser tool={r.data} /></li>)}
          </ul>

          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {
              [
                comparison && { href: compareUrl(comparison.data.slug), kicker: 'Head to head', text: comparison.data.title },
                trade && {
                  href: bestUrl(trade.data.category, trade.data.slug),
                  kicker: 'Ranked list',
                  text: `Best ${CATEGORY_META[trade.data.category].label.toLowerCase()} for ${trade.data.name.toLowerCase()}`,
                },
                alternativePage && { href: alternativesUrl(t.slug), kicker: 'Thinking of switching?', text: `${t.name} alternatives` },
                { href: CALCULATOR_URL, kicker: 'Free tool', text: 'Hourly rate calculator' },
              ]
                .filter(Boolean)
                .map((l) => (
                  <li>
                    <a href={l!.href} class="card card-link flex h-full items-center justify-between gap-3 p-4 no-underline">
                      <span>
                        <span class="block text-xs font-semibold uppercase tracking-wide text-ink-muted">{l!.kicker}</span>
                        <span class="mt-0.5 block font-semibold text-ink">{l!.text}</span>
                      </span>
                      <span class="text-brand" aria-hidden="true">&rarr;</span>
                    </a>
                  </li>
                ))
            }
          </ul>
        </section>
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-5">
          <div class="card p-5">
            <div class="flex items-center gap-3">
              <LogoMark text={t.logoText} color={t.logoColor} size="sm" />
              <div class="min-w-0 flex-1">
                <p class="font-semibold leading-tight text-ink">{t.name}</p>
                <p class="text-sm text-ink-muted">{priceLabel(t.priceFrom)}</p>
              </div>
              <ScoreBadge score={t.score} />
            </div>
            <AffiliateLink slug={t.slug} name={t.name} label={`Try ${t.name}`} placement="sidebar" class="btn-block mt-4" />
            <p class="mt-2 text-center text-xs text-ink-muted">{t.freeTrial}</p>
          </div>

          <nav class="card p-5" aria-label="On this page">
            <p class="text-sm font-semibold text-ink">On this page</p>
            <ol class="mt-3 space-y-2 text-sm">
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} class="text-ink-muted no-underline hover:text-brand">{item.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </aside>
    </div>
  </article>

  <StickyCta slug={t.slug} name={t.name} logoText={t.logoText} logoColor={t.logoColor} note={priceLabel(t.priceFrom)} />
</BaseLayout>
